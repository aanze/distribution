#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2026 ROCKNIX/DUCKTALE
#
# ADSP incident black-box for SM8750 (AYN Odin 3).
#
# The ADSP owns audio (q6apm), the sensor core (SSC), battmgr and USB-PD.
# Its crashes/restarts have been eating the platform from below (qsh boot
# crash -> no sound; mid-session incident 2026-07-21 -> PD contract lost ->
# battery silently drained while plugged) and by the time anyone looks, the
# evidence has rotated out of the dmesg ring. This watcher polls the kernel
# log for remoteproc distress signatures and snapshots FULL context to
# /storage the moment one appears, so the NEXT incident hands us the root
# cause instead of a cold trail.
#
# Cheap by design: one dmesg scan every 10s, no clearing, dedup by last-seen
# timestamp; snapshots are a few hundred KB, capped at 20.

OUT=/storage/adsp-blackbox
INTERVAL=10
# Precise distress signatures only. NOT a bare "SMEM" (matched the benign
# boot line "nomap non-reusable smem@81d00000" -> false captures every boot)
# and NOT a bare "Assertion" (too generic). This device has no RTC, so an
# early-boot capture gets a bogus wall-clock date; the trigger line is the
# only reliable discriminator, hence the tight patterns. Real qsh boot crash
# (no-sound bug) matches via "fatal error"/"err_qdi".
#
# The q6apm patterns cover the ADSP wedging WITHOUT crashing: remoteproc stays
# "running", nothing here fired, and yet every audio graph setup timed out
# (-110). Userspace paid for it far from the cause - each EmulationStation
# start blocked ~60s in SDL audio init, which read on screen as a black panel
# for a minute after every dock plug or unplug (2026-07-30). Diagnosing it
# meant reconstructing the chain by hand because the black box, watching only
# for crash signatures, had captured nothing.
PATTERN='remoteproc[0-9]*:.*fatal error|err_qdi|listener_hexagon.*Assertion|recovering remoteproc|remoteproc.*crash|watchdog bite|rproc.*boot failed|qcom_q6v5.*(fatal|watchdog)|q6apm.*Failed to prepare Graph|q6apm.*ASoC error|q6apm.*failed to stop APM port|snd_soc_dai_prepare'
MAX_SNAPSHOTS=20

mkdir -p "${OUT}"
last=""

snapshot() {
  # This device has no RTC, so wall-clock is bogus until NTP sync (esp. at
  # boot). Prefix the dir with monotonic uptime seconds so captures always
  # sort correctly and an early-boot capture is recognisable as such.
  up="$(cut -d. -f1 /proc/uptime 2>/dev/null)"
  ts="up$(printf '%08d' "${up:-0}")s-$(date '+%Y%m%d-%H%M%S')"
  d="${OUT}/${ts}"
  mkdir -p "${d}"
  dmesg > "${d}/dmesg.txt" 2>/dev/null
  {
    date; echo "uptime_s: ${up}"
    # printk timestamps come from local_clock(), which does NOT advance across
    # suspend, while /proc/uptime above DOES. After a long deep-suspend dmesg
    # therefore looks "frozen" a few seconds after boot (incident 2026-07-30:
    # uptime 86612s, last dmesg line at 33s - which reads as a wedged printk
    # and sent the first analysis down the wrong path). Record the monotonic
    # clock as well so any dmesg timestamp can be mapped back to wall-clock,
    # and dump the suspend counters so a resume-triggered incident is
    # recognisable as one without having to infer it.
    echo "monotonic_ns: $(grep -m1 '^now at' /proc/timer_list 2>/dev/null | tr -dc '0-9')"
    echo "--- suspend stats:"
    for f in /sys/power/suspend_stats/*; do
      [ -f "$f" ] && echo "${f##*/}: $(cat "$f" 2>/dev/null)"
    done
    echo "--- trigger line:"; echo "$1"
    echo "--- remoteproc states:"
    for r in /sys/class/remoteproc/remoteproc*; do
      echo "$r: $(cat "$r/state" 2>/dev/null) ($(cat "$r/name" 2>/dev/null))"
    done
    echo "--- battery:"; cat /sys/class/power_supply/battery/uevent 2>/dev/null
    echo "--- usb in:"; cat /sys/class/power_supply/qcom-battmgr-usb/uevent 2>/dev/null
    echo "--- typec:"; cat /sys/class/typec/port0/power_operation_mode 2>/dev/null
    echo "--- irqs:"; grep -E 'smp2p|q6v5|glink' /proc/interrupts 2>/dev/null
    echo "--- audio cards:"; cat /proc/asound/cards 2>/dev/null
    # Audio path health. A wedged ADSP still reports "running", so the card
    # list alone says nothing; what gives it away is that every ALSA setup
    # times out. The probes MUST be bounded, because wpctl and pw-cli hang
    # outright in that state - and a hang here would freeze the black box
    # itself. That they time out at all is the most telling signal.
    echo "--- audio services:"
    for s in pipewire pipewire-pulse wireplumber; do
      echo "$s: $(systemctl is-active $s 2>/dev/null)"
    done
    echo -n "--- pipewire answers: "
    if timeout 5 wpctl status >/dev/null 2>&1; then echo "yes"; else echo "NO (hung or failed)"; fi
    echo "--- pcm states:"
    for f in /proc/asound/card*/pcm*/sub*/status; do
      [ -f "$f" ] && echo "${f#/proc/asound/}: $(head -1 "$f" 2>/dev/null)"
    done
    # Who was actually talking to the ADSP when it died. The 2026-07-30 fatal
    # was a firmware assertion inside the ADSP's own fastrpc listener
    # (listener_hexagon.c: "Assertion prevCtx == notify failed"), and with no
    # client inventory there was no way to tell which fastrpc user provoked it
    # - the audio PD, the sensor PD (odin3-sensors' adsprpcd), or something
    # else entirely. Cheap: one readlink pass over open fds.
    echo "--- adsp clients (open fastrpc/rpmsg fds):"
    for p in /proc/[0-9]*; do
      fds="$(ls -l "$p"/fd 2>/dev/null | grep -oE '/dev/(fastrpc|rpmsg)[^ ]*' | sort -u | tr '\n' ' ')"
      [ -n "${fds}" ] && echo "${p#/proc/} $(cat "$p/comm" 2>/dev/null): ${fds}"
    done
    echo "--- services:"; for s in odin3-sensors charge-care charge-guard; do
      echo "$s: $(systemctl is-active $s 2>/dev/null)"
    done
  } > "${d}/context.txt" 2>/dev/null
  # short-precise: microsecond timestamps. The default second granularity made
  # the 2026-07-30 incident undecidable - the userspace sensor client and the
  # ADSP fatal both landed in the same "13:27:56" bucket, so cause could not be
  # separated from consequence. Sub-second ordering is the whole point of a
  # black box.
  journalctl -b --no-pager -o short-precise > "${d}/journal.txt" 2>/dev/null
  logger -t adsp-blackbox "ADSP incident captured -> ${d}"
  # rotation: keep the newest MAX_SNAPSHOTS (name sorts by uptime prefix)
  ls -1d "${OUT}"/up*s-* 2>/dev/null | head -n -"${MAX_SNAPSHOTS}" | while read -r old; do
    rm -rf "${old}"
  done
}

while :; do
  hit="$(dmesg 2>/dev/null | grep -iE "${PATTERN}" | grep -v adsp-blackbox | tail -1)"
  if [ -n "${hit}" ] && [ "${hit}" != "${last}" ]; then
    snapshot "${hit}"
    last="${hit}"
  fi
  sleep "${INTERVAL}"
done
