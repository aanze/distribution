#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2026 ROCKNIX (https://github.com/ROCKNIX)
#
# Toggle battery bypass charging on SM8750 (AYN Odin 3).
# Drives the kernel charge_behaviour control exposed by qcom_battmgr:
#   inhibit-charge -> run the system from the charger, leave the battery
#                     untouched (neither charging nor discharging) = bypass
#   auto           -> normal charging
#
# Usage: charge-bypass {on|off|apply|status}
#   apply re-applies the saved preference (system.bypasscharge) and is run
#   at boot, since the firmware resets to normal charging on every reboot.

. /etc/profile

NODE="/sys/class/power_supply/battery/charge_behaviour"

apply_value() {
  # ${1}: 1 = bypass (inhibit-charge), 0 = normal (auto)
  [ -e "${NODE}" ] || return 0
  if [ "${1}" = "1" ]; then
    echo "inhibit-charge" >"${NODE}" 2>/dev/null
  else
    echo "auto" >"${NODE}" 2>/dev/null
  fi
}

case "${1}" in
  on|1|true)
    set_setting system.bypasscharge 1
    apply_value 1
    ;;
  off|0|false)
    set_setting system.bypasscharge 0
    apply_value 0
    ;;
  apply|"")
    # Wait briefly for the battmgr module to expose the node at boot.
    i=0
    while [ ! -e "${NODE}" ] && [ "${i}" -lt 10 ]; do
      sleep 1
      i=$((i + 1))
    done
    if [ "$(get_setting system.bypasscharge)" = "1" ]; then
      apply_value 1
    else
      apply_value 0
    fi
    ;;
  status)
    [ -e "${NODE}" ] && cat "${NODE}"
    ;;
  *)
    echo "usage: charge-bypass {on|off|apply|status}" >&2
    exit 1
    ;;
esac
