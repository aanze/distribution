From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Anze <aanzdev@gmail.com>
Date: Fri, 12 Jun 2026 16:00:00 +0200
Subject: [PATCH] PM: sleep: SM8750 persist DPM-watchdog culprit in PMIC SDAM

No pstore on this device (XBL scrubs DRAM every boot), so a DPM
watchdog panic during resume leaves no trace of which device hung.
Write the hung device's driver+name into a spare pmk8550 SDAM window
(survives reboot) from the watchdog handler; read back via nvmem.

---
--- a/drivers/nvmem/qcom-spmi-sdam.c
--- a/drivers/nvmem/qcom-spmi-sdam.c
+++ b/drivers/nvmem/qcom-spmi-sdam.c
@@ -9,6 +9,8 @@
 #include <linux/nvmem-provider.h>
 #include <linux/platform_device.h>
 #include <linux/regmap.h>
+#include <linux/spmi.h>
+#include <linux/panic_notifier.h>
 
 #define SDAM_MEM_START			0x40
 #define REGISTER_MAP_ID			0x40
@@ -108,6 +110,72 @@
 	return rc;
 }
 
+/*
+ * ROCKNIX: persistent DPM-watchdog breadcrumb.
+ *
+ * DRAM is scrubbed by XBL on every boot (no pstore/ramoops on this
+ * device), but PMIC SDAM contents survive a panic reboot. Stash the
+ * name of a device that hangs suspend/resume in a spare SDAM window so
+ * it can be read back after the watchdog panic via the nvmem sysfs.
+ * Uses spmi_ext_register_writel() directly (pmic-arb is spinlock+poll)
+ * because the regmap mutex must not be taken from timer context.
+ */
+#define ROCKNIX_BC_OFFSET	0x90
+#define ROCKNIX_BC_LEN		0x28
+
+static struct spmi_device *rocknix_bc_sdev;
+static u16 rocknix_bc_addr;
+static struct spmi_device *rocknix_panic_sdev;
+static u16 rocknix_panic_addr;
+
+/* The pmic-arb does at most 8 bytes per SPMI transaction. */
+static void rocknix_bc_write(struct spmi_device *sdev, u16 addr,
+			     const char *buf, size_t len)
+{
+	size_t off, n;
+
+	for (off = 0; off < len; off += n) {
+		n = min_t(size_t, len - off, 8);
+		if (spmi_ext_register_writel(sdev, addr + off,
+					     buf + off, n) < 0)
+			break;
+	}
+}
+
+void rocknix_dpm_breadcrumb(const char *drv, const char *name)
+{
+	struct spmi_device *sdev = READ_ONCE(rocknix_bc_sdev);
+	char buf[ROCKNIX_BC_LEN];
+
+	if (!sdev)
+		return;
+	memset(buf, 0, sizeof(buf));
+	snprintf(buf, sizeof(buf), "%s %s", drv, name);
+	rocknix_bc_write(sdev, rocknix_bc_addr, buf, sizeof(buf));
+}
+
+#define ROCKNIX_PANIC_OFF	0x50
+#define ROCKNIX_PANIC_LEN	0x68
+
+static int rocknix_panic_notify(struct notifier_block *nb,
+				unsigned long event, void *data)
+{
+	struct spmi_device *sdev = READ_ONCE(rocknix_panic_sdev);
+	char buf[ROCKNIX_PANIC_LEN];
+
+	if (sdev && data) {
+		memset(buf, 0, sizeof(buf));
+		strscpy(buf, (const char *)data, sizeof(buf));
+		rocknix_bc_write(sdev, rocknix_panic_addr, buf, sizeof(buf));
+	}
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block rocknix_panic_nb = {
+	.notifier_call = rocknix_panic_notify,
+	.priority = INT_MAX,
+};
+
 static int sdam_probe(struct platform_device *pdev)
 {
 	struct sdam_chip *sdam;
@@ -144,7 +212,9 @@
 	sdam->sdam_config.owner = THIS_MODULE;
 	sdam->sdam_config.add_legacy_fixed_of_cells = true;
 	sdam->sdam_config.stride = 1;
-	sdam->sdam_config.size = sdam->size;
+	/* ROCKNIX: window starts at SDAM_MEM_START; size the file so the
+	 * whole window is reachable (reads below 0x40 still -EINVAL). */
+	sdam->sdam_config.size = SDAM_MEM_START + sdam->size;
 	sdam->sdam_config.word_size = 1;
 	sdam->sdam_config.reg_read = sdam_read;
 	sdam->sdam_config.reg_write = sdam_write;
@@ -161,6 +231,49 @@
 		"SDAM base=%#x size=%u registered successfully\n",
 		sdam->base, sdam->size);
 
+	if (of_property_read_bool(pdev->dev.of_node,
+				  "rocknix,dpm-breadcrumb")) {
+		struct spmi_device *sdev = to_spmi_device(pdev->dev.parent);
+		u8 prev[4], test[4] = { 'R', 'C', 'K', '!' }, back[4] = {};
+		u16 taddr = sdam->base + sdam->size + SDAM_MEM_START - 4;
+
+		/*
+		 * The SPMI arbiter only accepts writes from the owner EE of
+		 * a peripheral, and ownership of the SDAMs is set by boot
+		 * firmware - so probe which candidate the AP can actually
+		 * write (and whether contents survive reboot) instead of
+		 * assuming. Test cell = last 4 bytes of the window; the
+		 * breadcrumb itself lives at ROCKNIX_BC_OFFSET.
+		 */
+		spmi_ext_register_readl(sdev, taddr, prev, sizeof(prev));
+		spmi_ext_register_writel(sdev, taddr, test, sizeof(test));
+		spmi_ext_register_readl(sdev, taddr, back, sizeof(back));
+
+		if (!memcmp(test, back, sizeof(test))) {
+			if (!READ_ONCE(rocknix_bc_sdev)) {
+				rocknix_bc_addr = sdam->base +
+						  ROCKNIX_BC_OFFSET;
+				WRITE_ONCE(rocknix_bc_sdev, sdev);
+			} else if (!READ_ONCE(rocknix_panic_sdev)) {
+				rocknix_panic_addr = sdam->base +
+						     ROCKNIX_PANIC_OFF;
+				WRITE_ONCE(rocknix_panic_sdev, sdev);
+				atomic_notifier_chain_register(
+					&panic_notifier_list,
+					&rocknix_panic_nb);
+			}
+			dev_info(&pdev->dev,
+				 "breadcrumb: SDAM %#x writable, prev %4ph%s\n",
+				 sdam->base, prev,
+				 rocknix_bc_addr == sdam->base + ROCKNIX_BC_OFFSET ?
+				 " (selected)" : "");
+		} else {
+			dev_info(&pdev->dev,
+				 "breadcrumb: SDAM %#x NOT writable (got %4ph)\n",
+				 sdam->base, back);
+		}
+	}
+
 	return 0;
 }
 
--- a/drivers/base/power/main.c
+++ b/drivers/base/power/main.c
@@ -39,6 +39,9 @@
 #include "../base.h"
 #include "power.h"
 
+/* ROCKNIX: implemented by qcom-spmi-sdam when DT opts in. */
+void __weak rocknix_dpm_breadcrumb(const char *drv, const char *name) { }
+
 typedef int (*pm_callback_t)(struct device *);
 
 /*
@@ -540,6 +543,9 @@
 	struct timer_list *timer = &wd->timer;
 	unsigned int time_left;
 
+	/* ROCKNIX: record the hung device in PMIC SDAM (survives reboot). */
+	rocknix_dpm_breadcrumb(dev_driver_string(wd->dev), dev_name(wd->dev));
+
 	if (wd->fatal) {
 		unsigned int this_cpu = smp_processor_id();
 
--- a/arch/arm64/boot/dts/qcom/pmk8550.dtsi
+++ b/arch/arm64/boot/dts/qcom/pmk8550.dtsi
@@ -62,8 +62,39 @@
 			interrupts = <0x0 0x62 0x1 IRQ_TYPE_EDGE_RISING>;
 		};
 
+		/*
+		 * ROCKNIX: candidate scratch SDAMs for the DPM-watchdog
+		 * breadcrumb; the driver test-writes each and uses the
+		 * first one the AP's EE actually owns. 0x7000 (XBL boot
+		 * flags) and 0xb600 (Type-C/ADSP) deliberately excluded.
+		 */
+		nvram@7400 {
+			compatible = "qcom,spmi-sdam";
+			rocknix,dpm-breadcrumb;
+			reg = <0x7400>;
+		};
+
+		nvram@7c00 {
+			compatible = "qcom,spmi-sdam";
+			rocknix,dpm-breadcrumb;
+			reg = <0x7c00>;
+		};
+
+		nvram@8400 {
+			compatible = "qcom,spmi-sdam";
+			rocknix,dpm-breadcrumb;
+			reg = <0x8400>;
+		};
+
+		nvram@9800 {
+			compatible = "qcom,spmi-sdam";
+			rocknix,dpm-breadcrumb;
+			reg = <0x9800>;
+		};
+
 		pmk8550_sdam_2: nvram@7100 {
 			compatible = "qcom,spmi-sdam";
+			rocknix,dpm-breadcrumb;
 			reg = <0x7100>;
 			#address-cells = <1>;
 			#size-cells = <1>;
