From: Anze <aanzdev@gmail.com>
Subject: [PATCH] ROCKNIX: drm/msm/dpu: out-of-band CWB screen capture (RGB + NV12)

Capture the live panel scanout into a kernel buffer via the dedicated Concurrent
WriteBack datapath (CWB mux -> dedicated CWB pingpong -> MERGE_3D -> [CDM] -> WB),
added to the realtime CTL's flush each kickoff. Kernel-initiated, so it is
independent of the userspace DRM master and works under any compositor
(EmulationStation/sway and gamescope/Steam) and survives the handoff.

debugfs /sys/kernel/debug/dpu_capture/: arm {p=probe|1=XRGB|2=NV12|0=off},
status, frame.raw. NV12 uses the CDM block for HW RGB->YUV420, feedable to the
Iris H.264 encoder for recording. Dual layer-mixer is stitched via MERGE_3D.

Signed-off-by: Anze <aanzdev@gmail.com>
diff --git a/drivers/gpu/drm/msm/Makefile b/drivers/gpu/drm/msm/Makefile
index ba45e99..d81acbb 100644
--- a/drivers/gpu/drm/msm/Makefile
+++ b/drivers/gpu/drm/msm/Makefile
@@ -69,6 +69,7 @@ msm-display-$(CONFIG_DRM_MSM_MDP5) += \
 	disp/mdp5/mdp5_smp.o \
 
 msm-display-$(CONFIG_DRM_MSM_DPU) += \
+	disp/dpu1/dpu_capture.o \
 	disp/dpu1/dpu_core_perf.o \
 	disp/dpu1/dpu_crtc.o \
 	disp/dpu1/dpu_encoder.o \
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_capture.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_capture.c
new file mode 100644
index 0000000..5b6c398
--- /dev/null
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_capture.c
@@ -0,0 +1,562 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * ROCKNIX/DUCKTALE: out-of-band DPU Concurrent WriteBack (CWB) screen capture.
+ *
+ * Programs the dedicated CWB datapath (CWB mux -> dedicated CWB pingpong ->
+ * MERGE_3D -> [CDM] -> WB) directly and adds the writeback to the *realtime*
+ * CTL's flush during each kickoff -- kernel-initiated, so capture is independent
+ * of whichever compositor (sway/ES, gamescope/Steam) holds the DRM master.
+ *
+ * Two output formats:
+ *   - XRGB8888 (arm '1'): screenshot-grade RGB grab.
+ *   - NV12     (arm '2'): YUV420 via the CDM block (HW RGB->YUV), feedable
+ *                         straight to the Iris H.264 encoder for recording.
+ *
+ * debugfs /sys/kernel/debug/dpu_capture/: arm {p|1|2|0}, status, frame.raw
+ */
+#define pr_fmt(fmt) "dpu_capture: " fmt
+
+#include <linux/debugfs.h>
+#include <linux/io.h>
+#include <linux/slab.h>
+#include <drm/drm_fourcc.h>
+
+#include "msm_kms.h"
+#include "msm_gem.h"
+#include "dpu_kms.h"
+#include "dpu_hw_mdss.h"
+#include "dpu_hw_catalog.h"
+#include "dpu_hw_ctl.h"
+#include "dpu_hw_wb.h"
+#include "dpu_hw_cwb.h"
+#include "dpu_hw_cdm.h"
+#include "dpu_hw_top.h"
+#include "dpu_hw_util.h"
+#include "dpu_hw_pingpong.h"
+#include "dpu_hw_merge3d.h"
+#include "dpu_core_irq.h"
+#include "dpu_vbif.h"
+#include "dpu_capture.h"
+
+#define CAP_W		1080
+#define CAP_H		1920
+#define CAP_MAX_LM	2
+
+/* XRGB8888: stride padded to 256B */
+#define RGB_STRIDE	ALIGN(CAP_W * 4, 256)
+#define RGB_SIZE	(RGB_STRIDE * CAP_H)
+
+/* NV12 (linear, pseudo-planar 4:2:0): Y plane then interleaved UV plane */
+#define NV12_Y_STRIDE	CAP_W
+#define NV12_Y_SIZE	(NV12_Y_STRIDE * CAP_H)
+#define NV12_UV_STRIDE	CAP_W
+#define NV12_UV_SIZE	(NV12_UV_STRIDE * (CAP_H / 2))
+#define NV12_SIZE	(NV12_Y_SIZE + NV12_UV_SIZE)
+
+#define CAP_BUF_SIZE	RGB_SIZE	/* alloc the larger; both fit */
+
+enum cap_mode { CAP_OFF = 0, CAP_PROBE, CAP_CAPTURE };
+enum cap_pix  { PIX_RGB = 0, PIX_NV12 };
+
+struct dpu_capture {
+	struct dpu_kms *kms;
+
+	struct dpu_hw_wb *wb;				/* WB_2 */
+	struct dpu_hw_cwb *cwb[CAP_MAX_LM];		/* CWB_0, CWB_1 */
+	struct dpu_hw_pingpong *dcwb_pp[CAP_MAX_LM];	/* PINGPONG_CWB_0/1 */
+	struct dpu_hw_merge_3d *merge3d;		/* MERGE_3D_4 */
+	struct dpu_hw_cdm *cdm;				/* CDM_0 (NV12) */
+	const struct msm_format *rgb_fmt;
+	const struct msm_format *nv12_fmt;
+	unsigned int wb_irq;
+
+	struct drm_gem_object *bo;
+	void *vaddr;
+	u64 iova;
+
+	enum cap_mode mode;
+	enum cap_pix pix;
+	bool irq_on;
+	int probe_logs;
+	atomic_t frames;
+
+	struct dentry *dir;
+};
+
+static struct dpu_capture *g_cap;
+
+static void dpu_capture_wb_done_irq(void *arg)
+{
+	struct dpu_capture *c = arg;
+
+	atomic_inc(&c->frames);
+}
+
+/* --- WB programming helpers (mirror dpu_encoder_phys_wb.c) --- */
+
+static bool cap_clk_force(struct dpu_capture *c, bool en, bool *forced)
+{
+	struct dpu_hw_wb *wb = c->wb;
+	struct dpu_hw_mdp *mdp = c->kms->hw_mdp;
+
+	if (wb->ops.setup_clk_force_ctrl) {
+		*forced = wb->ops.setup_clk_force_ctrl(wb, en);
+		return true;
+	}
+	if (mdp && mdp->ops.setup_clk_force_ctrl) {
+		*forced = mdp->ops.setup_clk_force_ctrl(mdp, wb->caps->clk_ctrl, en);
+		return true;
+	}
+	return false;
+}
+
+static void cap_set_ot_limit(struct dpu_capture *c)
+{
+	struct dpu_vbif_set_ot_params ot = {0};
+	bool forced = false;
+
+	ot.xin_id = c->wb->caps->xin_id;
+	ot.num = c->wb->idx - WB_0;
+	ot.width = CAP_W;
+	ot.height = CAP_H;
+	ot.is_wfd = false;
+	ot.frame_rate = 120;
+	ot.vbif_idx = c->wb->caps->vbif_idx;
+	ot.rd = false;
+
+	if (!cap_clk_force(c, true, &forced))
+		return;
+	dpu_vbif_set_ot_limit(c->kms, &ot);
+	if (forced)
+		cap_clk_force(c, false, &forced);
+}
+
+static void cap_set_qos_remap(struct dpu_capture *c)
+{
+	struct dpu_vbif_set_qos_params q = {0};
+	bool forced = false;
+
+	q.vbif_idx = c->wb->caps->vbif_idx;
+	q.xin_id = c->wb->caps->xin_id;
+	q.num = c->wb->idx - WB_0;
+	q.is_rt = true;
+
+	if (!cap_clk_force(c, true, &forced))
+		return;
+	dpu_vbif_set_qos_remap(c->kms, &q);
+	if (forced)
+		cap_clk_force(c, false, &forced);
+}
+
+static void cap_set_qos(struct dpu_capture *c)
+{
+	const struct dpu_perf_cfg *perf = c->kms->catalog->perf;
+	const struct dpu_qos_lut_tbl *tbl;
+	struct dpu_hw_qos_cfg qos = {0};
+
+	qos.danger_safe_en = true;
+	qos.danger_lut = perf->danger_lut_tbl[DPU_QOS_LUT_USAGE_NRT];
+	qos.safe_lut = perf->safe_lut_tbl[DPU_QOS_LUT_USAGE_NRT];
+	tbl = &perf->qos_lut_tbl[DPU_QOS_LUT_USAGE_NRT];
+	qos.creq_lut = _dpu_hw_get_qos_lut(tbl, 0);
+
+	if (c->wb->ops.setup_qos_lut)
+		c->wb->ops.setup_qos_lut(c->wb, &qos);
+}
+
+/* CDM RGB->YUV420 for NV12 output (mirrors dpu_encoder_helper_phys_setup_cdm) */
+static void cap_setup_cdm(struct dpu_capture *c, enum dpu_pingpong pp, bool enable)
+{
+	struct dpu_hw_cdm_cfg cfg = {0};
+
+	if (!c->cdm)
+		return;
+
+	if (!enable) {
+		if (c->cdm->ops.bind_pingpong_blk)
+			c->cdm->ops.bind_pingpong_blk(c->cdm, PINGPONG_NONE);
+		return;
+	}
+
+	cfg.output_width = CAP_W;
+	cfg.output_height = CAP_H;
+	cfg.output_fmt = c->nv12_fmt;
+	cfg.output_type = CDM_CDWN_OUTPUT_WB;
+	cfg.output_bit_depth = CDM_CDWN_OUTPUT_8BIT;
+	cfg.csc_cfg = &dpu_csc10_rgb2yuv_601l;
+	cfg.h_cdwn_type = CDM_CDWN_COSITE;	/* 4:2:0 */
+	cfg.v_cdwn_type = CDM_CDWN_OFFSITE;	/* 4:2:0 */
+	cfg.pp_id = pp;
+
+	if (c->cdm->ops.enable)
+		c->cdm->ops.enable(c->cdm, &cfg);
+}
+
+/* program the CWB datapath and flush on the realtime CTL */
+static void cap_program(struct dpu_capture *c, struct dpu_hw_ctl *ctl,
+			const enum dpu_pingpong *rt_pp, int num_pp)
+{
+	const struct dpu_perf_cfg *perf = c->kms->catalog->perf;
+	bool nv12 = (c->pix == PIX_NV12);
+	struct dpu_hw_cwb_setup_cfg cwb_cfg;
+	struct dpu_hw_wb_cfg wb_cfg;
+	enum dpu_merge_3d merge = 0;
+	enum dpu_cdm cdm_idx = 0;
+	u32 cwb_mask = 0;
+	int i;
+
+	/* CWB mux taps per realtime pingpong's layer-mixer output */
+	for (i = 0; i < num_pp; i++) {
+		cwb_cfg.input = INPUT_MODE_LM_OUT;
+		cwb_cfg.pp_idx = rt_pp[i];
+		c->cwb[i]->ops.config_cwb(c->cwb[i], &cwb_cfg);
+		cwb_mask |= BIT(c->cwb[i]->idx - CWB_0);
+	}
+
+	/* dual-LM: merge the two dedicated CWB pingpongs (display's 3D mode) */
+	if (num_pp == CAP_MAX_LM && c->merge3d) {
+		if (c->merge3d->ops.setup_3d_mode)
+			c->merge3d->ops.setup_3d_mode(c->merge3d, BLEND_3D_H_ROW_INT);
+		merge = c->merge3d->idx;
+	} else if (c->merge3d && c->merge3d->ops.setup_3d_mode) {
+		c->merge3d->ops.setup_3d_mode(c->merge3d, BLEND_3D_NONE);
+	}
+
+	cap_set_ot_limit(c);
+	cap_set_qos_remap(c);
+	cap_set_qos(c);
+
+	/* CDM converts RGB->NV12 in HW; disable it for RGB capture */
+	cap_setup_cdm(c, c->dcwb_pp[0]->idx, nv12);
+	if (nv12 && c->cdm)
+		cdm_idx = c->cdm->idx;
+
+	memset(&wb_cfg, 0, sizeof(wb_cfg));
+	wb_cfg.intf_mode = INTF_MODE_WB_LINE;
+	wb_cfg.roi.x1 = 0;
+	wb_cfg.roi.x2 = CAP_W;
+	wb_cfg.roi.y1 = 0;
+	wb_cfg.roi.y2 = CAP_H;
+	wb_cfg.dest.width = CAP_W;
+	wb_cfg.dest.height = CAP_H;
+	if (nv12) {
+		wb_cfg.dest.num_planes = 2;
+		wb_cfg.dest.plane_addr[0] = lower_32_bits(c->iova);
+		wb_cfg.dest.plane_pitch[0] = NV12_Y_STRIDE;
+		wb_cfg.dest.plane_size[0] = NV12_Y_SIZE;
+		wb_cfg.dest.plane_addr[1] = lower_32_bits(c->iova) + NV12_Y_SIZE;
+		wb_cfg.dest.plane_pitch[1] = NV12_UV_STRIDE;
+		wb_cfg.dest.plane_size[1] = NV12_UV_SIZE;
+	} else {
+		wb_cfg.dest.num_planes = 1;
+		wb_cfg.dest.plane_addr[0] = lower_32_bits(c->iova);
+		wb_cfg.dest.plane_pitch[0] = RGB_STRIDE;
+		wb_cfg.dest.plane_size[0] = RGB_SIZE;
+	}
+
+	if (c->wb->ops.setup_roi)
+		c->wb->ops.setup_roi(c->wb, &wb_cfg);
+	if (c->wb->ops.setup_outformat)
+		c->wb->ops.setup_outformat(c->wb, &wb_cfg,
+			nv12 ? c->nv12_fmt : c->rgb_fmt);
+	if (c->wb->ops.setup_cdp)
+		c->wb->ops.setup_cdp(c->wb, nv12 ? c->nv12_fmt : c->rgb_fmt,
+			perf->cdp_cfg[DPU_PERF_CDP_USAGE_RT].wr_enable);
+	if (c->wb->ops.setup_outaddress)
+		c->wb->ops.setup_outaddress(c->wb, &wb_cfg);
+	if (c->wb->ops.bind_pingpong_blk)
+		c->wb->ops.bind_pingpong_blk(c->wb, c->dcwb_pp[0]->idx);
+
+	if (ctl->ops.set_capture_active)
+		ctl->ops.set_capture_active(ctl, c->wb->idx, cwb_mask, merge, cdm_idx);
+	for (i = 0; i < num_pp; i++)
+		if (ctl->ops.update_pending_flush_cwb)
+			ctl->ops.update_pending_flush_cwb(ctl, c->cwb[i]->idx);
+	if (merge && ctl->ops.update_pending_flush_merge_3d)
+		ctl->ops.update_pending_flush_merge_3d(ctl, merge);
+	if (cdm_idx && ctl->ops.update_pending_flush_cdm)
+		ctl->ops.update_pending_flush_cdm(ctl, cdm_idx);
+	if (ctl->ops.update_pending_flush_wb)
+		ctl->ops.update_pending_flush_wb(ctl, c->wb->idx);
+}
+
+/* called from the realtime encoder kickoff, under enc_spinlock */
+void dpu_capture_kickoff(struct dpu_kms *dpu_kms, struct dpu_hw_ctl *ctl,
+			 const enum dpu_pingpong *rt_pp, int num_pp)
+{
+	struct dpu_capture *c = g_cap;
+
+	if (!c || c->mode == CAP_OFF || !ctl || c->kms != dpu_kms)
+		return;
+
+	if (c->mode == CAP_PROBE) {
+		if (c->probe_logs < 8) {
+			pr_info("probe: ctl=%d num_pp=%d pp=[%d %d %d %d]\n",
+				ctl->idx, num_pp,
+				num_pp > 0 ? rt_pp[0] : -1,
+				num_pp > 1 ? rt_pp[1] : -1,
+				num_pp > 2 ? rt_pp[2] : -1,
+				num_pp > 3 ? rt_pp[3] : -1);
+			c->probe_logs++;
+		}
+		return;
+	}
+
+	if (!c->iova || num_pp < 1 || num_pp > CAP_MAX_LM) {
+		if (c->probe_logs < 4) {
+			pr_warn("capture skipped: num_pp=%d unsupported\n", num_pp);
+			c->probe_logs++;
+		}
+		return;
+	}
+
+	cap_program(c, ctl, rt_pp, num_pp);
+}
+
+static int dpu_capture_alloc_buf(struct dpu_capture *c)
+{
+	c->vaddr = msm_gem_kernel_new(c->kms->dev, CAP_BUF_SIZE, MSM_BO_WC,
+				      c->kms->base.vm, &c->bo, &c->iova);
+	if (IS_ERR(c->vaddr)) {
+		int ret = PTR_ERR(c->vaddr);
+
+		c->vaddr = NULL;
+		c->bo = NULL;
+		c->iova = 0;
+		return ret;
+	}
+	memset(c->vaddr, 0, CAP_BUF_SIZE);
+	return 0;
+}
+
+static void dpu_capture_free_buf(struct dpu_capture *c)
+{
+	if (c->bo) {
+		msm_gem_unpin_iova(c->bo, c->kms->base.vm);
+		drm_gem_object_put(c->bo);
+	}
+	c->bo = NULL;
+	c->vaddr = NULL;
+	c->iova = 0;
+}
+
+static void dpu_capture_disarm(struct dpu_capture *c)
+{
+	if (c->mode == CAP_OFF)
+		return;
+	c->mode = CAP_OFF;
+	if (c->irq_on) {
+		dpu_core_irq_unregister_callback(c->kms, c->wb_irq);
+		c->irq_on = false;
+	}
+	dpu_capture_free_buf(c);
+	pr_info("disarmed (%d frames)\n", atomic_read(&c->frames));
+}
+
+static int dpu_capture_arm_probe(struct dpu_capture *c)
+{
+	dpu_capture_disarm(c);
+	c->probe_logs = 0;
+	c->mode = CAP_PROBE;
+	pr_info("armed: PROBE (log-only)\n");
+	return 0;
+}
+
+static int dpu_capture_arm_capture(struct dpu_capture *c, enum cap_pix pix)
+{
+	int ret;
+
+	if (pix == PIX_NV12 && (!c->cdm || !c->nv12_fmt)) {
+		pr_warn("NV12 unavailable (cdm=%p nv12_fmt=%p)\n", c->cdm, c->nv12_fmt);
+		return -ENODEV;
+	}
+
+	dpu_capture_disarm(c);
+
+	ret = dpu_capture_alloc_buf(c);
+	if (ret) {
+		pr_err("buffer alloc failed: %d\n", ret);
+		return ret;
+	}
+	atomic_set(&c->frames, 0);
+	c->probe_logs = 0;
+	c->pix = pix;
+
+	ret = dpu_core_irq_register_callback(c->kms, c->wb_irq,
+					     dpu_capture_wb_done_irq, c);
+	if (ret) {
+		pr_err("wb irq register failed: %d\n", ret);
+		dpu_capture_free_buf(c);
+		return ret;
+	}
+	c->irq_on = true;
+	c->mode = CAP_CAPTURE;
+	pr_info("armed: CAPTURE %s %ux%u iova=%pad\n",
+		pix == PIX_NV12 ? "NV12" : "XRGB8888", CAP_W, CAP_H, &c->iova);
+	return 0;
+}
+
+/* ---- debugfs ---- */
+
+static ssize_t arm_write(struct file *file, const char __user *ubuf,
+			 size_t count, loff_t *ppos)
+{
+	struct dpu_capture *c = file->private_data;
+	char buf[8];
+	size_t n = min(count, sizeof(buf) - 1);
+
+	if (copy_from_user(buf, ubuf, n))
+		return -EFAULT;
+	buf[n] = '\0';
+
+	if (buf[0] == 'p' || buf[0] == 'P')
+		dpu_capture_arm_probe(c);
+	else if (buf[0] == '1')
+		dpu_capture_arm_capture(c, PIX_RGB);
+	else if (buf[0] == '2')
+		dpu_capture_arm_capture(c, PIX_NV12);
+	else
+		dpu_capture_disarm(c);
+	return count;
+}
+
+static const struct file_operations arm_fops = {
+	.open = simple_open,
+	.write = arm_write,
+	.llseek = default_llseek,
+};
+
+static ssize_t status_read(struct file *file, char __user *ubuf,
+			   size_t count, loff_t *ppos)
+{
+	struct dpu_capture *c = file->private_data;
+	const char *m = c->mode == CAP_CAPTURE ? "capture" :
+			c->mode == CAP_PROBE ? "probe" : "off";
+	u32 size = c->pix == PIX_NV12 ? NV12_SIZE : RGB_SIZE;
+	char buf[240];
+	int n;
+
+	n = scnprintf(buf, sizeof(buf),
+		      "mode=%s pix=%s frames=%d w=%u h=%u size=%u rgb_stride=%u nv12_ystride=%u iova=0x%llx wb=%d cwb=[%d,%d] dcwb_pp=[%d,%d] merge3d=%d cdm=%d\n",
+		      m, c->pix == PIX_NV12 ? "nv12" : "rgb",
+		      atomic_read(&c->frames), CAP_W, CAP_H, size,
+		      RGB_STRIDE, NV12_Y_STRIDE, (u64)c->iova,
+		      c->wb ? c->wb->idx : -1,
+		      c->cwb[0] ? c->cwb[0]->idx : -1,
+		      c->cwb[1] ? c->cwb[1]->idx : -1,
+		      c->dcwb_pp[0] ? c->dcwb_pp[0]->idx : -1,
+		      c->dcwb_pp[1] ? c->dcwb_pp[1]->idx : -1,
+		      c->merge3d ? c->merge3d->idx : -1,
+		      c->cdm ? c->cdm->idx : -1);
+	return simple_read_from_buffer(ubuf, count, ppos, buf, n);
+}
+
+static const struct file_operations status_fops = {
+	.open = simple_open,
+	.read = status_read,
+	.llseek = default_llseek,
+};
+
+static ssize_t frame_read(struct file *file, char __user *ubuf,
+			  size_t count, loff_t *ppos)
+{
+	struct dpu_capture *c = file->private_data;
+	u32 size = c->pix == PIX_NV12 ? NV12_SIZE : RGB_SIZE;
+
+	if (!c->vaddr)
+		return 0;
+	dma_rmb();
+	return simple_read_from_buffer(ubuf, count, ppos, c->vaddr, size);
+}
+
+static const struct file_operations frame_fops = {
+	.open = simple_open,
+	.read = frame_read,
+	.llseek = default_llseek,
+};
+
+/* ---- init / destroy ---- */
+
+static void dpu_capture_fetch_blocks(struct dpu_capture *c)
+{
+	struct dpu_rm *rm = &c->kms->rm;
+	int i, n, pp0;
+
+	for (i = 0; i < ARRAY_SIZE(rm->hw_wb); i++) {
+		if (rm->hw_wb[i]) {
+			c->wb = rm->hw_wb[i];
+			break;
+		}
+	}
+	for (i = 0, n = 0; i < ARRAY_SIZE(rm->cwb_blks) && n < CAP_MAX_LM; i++) {
+		if (rm->cwb_blks[i])
+			c->cwb[n++] = to_dpu_hw_cwb(rm->cwb_blks[i]);
+	}
+	pp0 = PINGPONG_CWB_0 - PINGPONG_0;
+	for (n = 0; n < CAP_MAX_LM; n++) {
+		int idx = pp0 + n;
+
+		if (idx < ARRAY_SIZE(rm->pingpong_blks) && rm->pingpong_blks[idx])
+			c->dcwb_pp[n] = to_dpu_hw_pingpong(rm->pingpong_blks[idx]);
+	}
+	if (c->dcwb_pp[0] && c->dcwb_pp[0]->merge_3d)
+		c->merge3d = c->dcwb_pp[0]->merge_3d;
+	if (rm->cdm_blk)
+		c->cdm = to_dpu_hw_cdm(rm->cdm_blk);
+}
+
+void dpu_capture_init(struct dpu_kms *dpu_kms)
+{
+	struct dpu_capture *c;
+
+	if (g_cap)
+		return;
+
+	c = kzalloc(sizeof(*c), GFP_KERNEL);
+	if (!c)
+		return;
+
+	c->kms = dpu_kms;
+	atomic_set(&c->frames, 0);
+	dpu_capture_fetch_blocks(c);
+
+	if (!c->wb || !c->cwb[0] || !c->cwb[1] ||
+	    !c->dcwb_pp[0] || !c->dcwb_pp[1] || !c->merge3d) {
+		pr_warn("CWB blocks missing (wb=%p cwb=%p,%p dcwb_pp=%p,%p merge3d=%p); disabled\n",
+			c->wb, c->cwb[0], c->cwb[1], c->dcwb_pp[0],
+			c->dcwb_pp[1], c->merge3d);
+		kfree(c);
+		return;
+	}
+	c->wb_irq = c->wb->caps->intr_wb_done;
+	c->rgb_fmt = mdp_get_format(&dpu_kms->base, DRM_FORMAT_XRGB8888, 0);
+	c->nv12_fmt = mdp_get_format(&dpu_kms->base, DRM_FORMAT_NV12, 0);
+	if (!c->rgb_fmt) {
+		pr_warn("no XRGB8888 format; disabled\n");
+		kfree(c);
+		return;
+	}
+
+	c->dir = debugfs_create_dir("dpu_capture", NULL);
+	debugfs_create_file("arm", 0200, c->dir, c, &arm_fops);
+	debugfs_create_file("status", 0400, c->dir, c, &status_fops);
+	debugfs_create_file("frame.raw", 0400, c->dir, c, &frame_fops);
+
+	g_cap = c;
+	pr_info("init: wb=%d cwb=[%d,%d] dcwb_pp=[%d,%d] merge3d=%d cdm=%d nv12=%d wb_irq=%u\n",
+		c->wb->idx, c->cwb[0]->idx, c->cwb[1]->idx,
+		c->dcwb_pp[0]->idx, c->dcwb_pp[1]->idx, c->merge3d->idx,
+		c->cdm ? c->cdm->idx : -1, c->nv12_fmt ? 1 : 0, c->wb_irq);
+}
+
+void dpu_capture_destroy(struct dpu_kms *dpu_kms)
+{
+	struct dpu_capture *c = g_cap;
+
+	if (!c || c->kms != dpu_kms)
+		return;
+	dpu_capture_disarm(c);
+	debugfs_remove_recursive(c->dir);
+	kfree(c);
+	g_cap = NULL;
+}
