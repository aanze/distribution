@@ -334,6 +334,54 @@ static void dpu_hw_ctl_update_pending_flush_cwb_v1(struct dpu_hw_ctl *ctx,
 	ctx->pending_flush_mask |= BIT(CWB_IDX);
 }
 
+static void dpu_hw_ctl_set_capture_active(struct dpu_hw_ctl *ctx,
+		enum dpu_wb wb, u32 cwb_mask, enum dpu_merge_3d merge_3d,
+		enum dpu_cdm cdm)
+{
+	struct dpu_hw_blk_reg_map *c = &ctx->hw;
+	u32 wb_active = DPU_REG_READ(c, CTL_WB_ACTIVE);
+	u32 cwb_active = DPU_REG_READ(c, CTL_CWB_ACTIVE);
+
+	wb_active |= BIT(wb - WB_0);
+	cwb_active |= cwb_mask;
+
+	DPU_REG_WRITE(c, CTL_WB_ACTIVE, wb_active);
+	DPU_REG_WRITE(c, CTL_CWB_ACTIVE, cwb_active);
+
+	if (merge_3d) {
+		u32 m3d_active = DPU_REG_READ(c, CTL_MERGE_3D_ACTIVE);
+
+		m3d_active |= BIT(merge_3d - MERGE_3D_0);
+		DPU_REG_WRITE(c, CTL_MERGE_3D_ACTIVE, m3d_active);
+	}
+
+	/* CDM ACTIVE takes the block id directly (matches dpu_hw_ctl_intf_cfg_v1) */
+	if (cdm)
+		DPU_REG_WRITE(c, CTL_CDM_ACTIVE, cdm);
+}
+
+static void dpu_hw_ctl_clear_capture_active(struct dpu_hw_ctl *ctx,
+		enum dpu_wb wb, u32 cwb_mask, enum dpu_merge_3d merge_3d,
+		enum dpu_cdm cdm)
+{
+	struct dpu_hw_blk_reg_map *c = &ctx->hw;
+	u32 wb_active = DPU_REG_READ(c, CTL_WB_ACTIVE) & ~BIT(wb - WB_0);
+	u32 cwb_active = DPU_REG_READ(c, CTL_CWB_ACTIVE) & ~cwb_mask;
+
+	DPU_REG_WRITE(c, CTL_WB_ACTIVE, wb_active);
+	DPU_REG_WRITE(c, CTL_CWB_ACTIVE, cwb_active);
+
+	if (merge_3d) {
+		u32 m3d_active = DPU_REG_READ(c, CTL_MERGE_3D_ACTIVE) &
+				~BIT(merge_3d - MERGE_3D_0);
+		DPU_REG_WRITE(c, CTL_MERGE_3D_ACTIVE, m3d_active);
+	}
+
+	/* realtime RGB path never uses CDM, so clearing it outright is safe */
+	if (cdm)
+		DPU_REG_WRITE(c, CTL_CDM_ACTIVE, 0);
+}
+
 static void dpu_hw_ctl_update_pending_flush_intf_v1(struct dpu_hw_ctl *ctx,
 		enum dpu_intf intf)
 {
