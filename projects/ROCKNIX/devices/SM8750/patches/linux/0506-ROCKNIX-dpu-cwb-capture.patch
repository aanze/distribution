 	 * cached pending_(intf_)flush_mask.
 	 * No effect on hardware
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_ctl.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_ctl.c
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_ctl.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_ctl.c
@@ -334,6 +334,20 @@
 	ctx->pending_flush_mask |= BIT(CWB_IDX);
 }
 
+static void dpu_hw_ctl_set_capture_active(struct dpu_hw_ctl *ctx,
+		enum dpu_wb wb, u32 cwb_mask)
+{
+	struct dpu_hw_blk_reg_map *c = &ctx->hw;
+	u32 wb_active = DPU_REG_READ(c, CTL_WB_ACTIVE);
+	u32 cwb_active = DPU_REG_READ(c, CTL_CWB_ACTIVE);
+
+	wb_active |= BIT(wb - WB_0);
+	cwb_active |= cwb_mask;
+
+	DPU_REG_WRITE(c, CTL_WB_ACTIVE, wb_active);
+	DPU_REG_WRITE(c, CTL_CWB_ACTIVE, cwb_active);
+}
+
 static void dpu_hw_ctl_update_pending_flush_intf_v1(struct dpu_hw_ctl *ctx,
 		enum dpu_intf intf)
 {
@@ -828,6 +842,7 @@
 			dpu_hw_ctl_update_pending_flush_merge_3d_v1;
 		c->ops.update_pending_flush_wb = dpu_hw_ctl_update_pending_flush_wb_v1;
 		c->ops.update_pending_flush_cwb = dpu_hw_ctl_update_pending_flush_cwb_v1;
+		c->ops.set_capture_active = dpu_hw_ctl_set_capture_active;
 		c->ops.update_pending_flush_dsc =
 			dpu_hw_ctl_update_pending_flush_dsc_v1;
 		c->ops.update_pending_flush_cdm = dpu_hw_ctl_update_pending_flush_cdm_v1;
