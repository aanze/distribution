From: ROCKNIX/DUCKTALE
Subject: [PATCH] pinctrl: sm8750: restore the dedicated intr_target register

The 7.1 merge window dropped .intr_target_reg from the sm8750 pingroup
definitions while pinctrl-msm gained a fallback that redirects interrupt
TARGET accesses into intr_cfg_reg when the field is 0. On sm8750 the
target register really is separate (cfg + 0x8): since 7.1 every GPIO irq
setup programs routing into the WRONG register and pollutes the config
bits. Runtime survives on reset defaults, but a TLMM line tied to the
USB-C cable path asserting during suspend is routed into a void -> hard
SoC wedge on any charger plug/unplug while asleep (7.0.11 good, all 7.1
kernels bad, all qcom drivers otherwise identical).

--- a/drivers/pinctrl/qcom/pinctrl-sm8750.c
+++ b/drivers/pinctrl/qcom/pinctrl-sm8750.c
@@ -47,6 +47,7 @@
 		.intr_status_bit = 0,                                 \
 		.intr_wakeup_present_bit = 6,                         \
 		.intr_wakeup_enable_bit = 7,                          \
+		.intr_target_reg = 0x8 + REG_SIZE * id,               \
 		.intr_target_bit = 8,                                 \
 		.intr_target_kpss_val = 3,                            \
 		.intr_raw_status_bit = 4,                             \
@@ -72,6 +73,7 @@
 		.out_bit = -1,                                       \
 		.intr_enable_bit = -1,                               \
 		.intr_status_bit = -1,                               \
+		.intr_target_reg = 0,                                \
 		.intr_target_bit = -1,                               \
 		.intr_raw_status_bit = -1,                           \
 		.intr_polarity_bit = -1,                             \
@@ -96,6 +98,7 @@
 		.out_bit = 0,				\
 		.intr_enable_bit = -1,			\
 		.intr_status_bit = -1,			\
+		.intr_target_reg = 0,			\
 		.intr_target_bit = -1,			\
 		.intr_raw_status_bit = -1,		\
 		.intr_polarity_bit = -1,		\
