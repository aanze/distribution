# DUCKTALE-CONTROLS (aanze fork) Decky plugin — shipped in the image and
# auto-deployed into Decky on boot. Drop-in deps snippet (see the deps.d
# loop in package.mk): file-add only, no shared-file edits.
case ${DEVICE} in
  SM8250|SM8550|SM8650|SM8750)
    PKG_DEPENDS_TARGET+=" ducktale-controls-plugin"
    ;;
esac
