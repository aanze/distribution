# GPU Driver Manager (swappable Mesa Turnip / Vulkan driver, per-game). Adreno
# (freedreno) handhelds only. Drop-in deps snippet (see the deps.d loop in
# package.mk): file-add only, no shared-file edits.
case ${DEVICE} in
  SM8250|SM8550|SM8650|SM8750)
    PKG_DEPENDS_TARGET+=" gpu-driver"
    ;;
esac
