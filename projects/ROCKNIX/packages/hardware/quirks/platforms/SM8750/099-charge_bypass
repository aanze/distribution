#
# Re-apply the saved bypass-charging preference at boot. The charger firmware
# resets to normal charging on every reboot, so restore the user's choice
# (system.bypasscharge) once the qcom_battmgr node is available.

. /etc/profile

/usr/bin/charge-bypass apply &
