#
# Re-apply the saved charging mode at boot (system.chargemode). The charger
# firmware does not reliably restore the bypass/limit state across a reboot, so
# restore the user's choice once the qcom_battmgr node is available. Runs after
# 099-charge_bypass (legacy), which it supersedes.

. /etc/profile

/usr/bin/charge-mode apply &

# Silent-drain watchdog: always on while the system runs (detects "plugged
# but discharging" after an ADSP/PD incident and alerts via the LED rings).
systemctl start charge-guard.service 2>/dev/null &
