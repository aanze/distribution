# Only count INTERNAL panels (DSI/eDP/LVDS). Counting every connected
# connector declared any handheld booted while docked a "dual screen" device:
# DSI + DP = 2, so the whole session then treated the dock like a second
# built-in panel - SDL_VIDEO_DISPLAY_PRIORITY put the internal panel first and
# a docked Steam launch came up on the handheld's screen instead of the
# monitor. A real dual-screen board has two built-in panels; an external on a
# hotpluggable connector is not one.
count=$(modetest | awk '$3 == "connected" && $4 ~ /^(DSI|eDP|LVDS)/ {print $0}' | wc -l)

if [ "$count" -ge 2 ]; then
    dual_screen=true
else
    dual_screen=false
fi

cat <<EOF >/storage/.config/profile.d/080-dual_screen_mode
DEVICE_HAS_DUAL_SCREEN=$dual_screen
EOF
