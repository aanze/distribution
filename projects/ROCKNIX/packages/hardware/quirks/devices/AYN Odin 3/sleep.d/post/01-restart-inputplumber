# Conditional recovery for an intermittent freeze of the AYN Odin3 gamepad
# after wake: the qcom-geni serial driver sometimes hits a WARN in
# qcom_geni_serial_suspend with rsinput attached, after which InputPlumber
# keeps a stale fd on /dev/inputplumber/sources/event4 and the virtual pad
# goes silent until a hard reboot.
#
# Restart IP only when that WARN appeared during the current suspend cycle.
# In the (much more common) clean-wake case IP stays untouched and the user
# does not see the controller disconnect/reconnect toast.

LAST_SLEEP_FILE="/run/.last_sleep_time"
[ -e "${LAST_SLEEP_FILE}" ] || exit 0
LAST_SLEEP=$(stat -c %Y "${LAST_SLEEP_FILE}" 2>/dev/null) || exit 0

if journalctl -k --since "@${LAST_SLEEP}" --no-pager 2>/dev/null \
     | grep -q "qcom_geni_serial_suspend"; then
  systemctl restart inputplumber
fi
