# Belt-and-suspenders safety net for the AYN Odin3 rsinput suspend freeze.
# Primary prevention is `rsinput` in /usr/config/modules.bad — the sleep hook
# unloads it pre-suspend so the qcom-geni serial port has no active client and
# qcom_geni_serial_suspend cannot WARN; on resume `modules start` reloads
# rsinput, the new input4 is auto-discovered by IP, and the controller works.
#
# If despite that the WARN still appears in this cycle's kernel log, the GENI
# serial bus is unrecoverable from userspace (tested 2026-05-31: even sysfs
# unbind/rebind cannot reset it — only a reboot does). The most we can do is
# kick IP so its CompositeDevice state is fresh; the underlying freeze will
# still require a manual reboot. The IP restart at least guarantees IP is not
# the bottleneck, so the user gets a faster, cleaner diagnosis than a silent
# stale-fd freeze.

LAST_SLEEP_FILE="/run/.last_sleep_time"
[ -e "${LAST_SLEEP_FILE}" ] || exit 0
LAST_SLEEP=$(stat -c %Y "${LAST_SLEEP_FILE}" 2>/dev/null) || exit 0

if journalctl -k --since "@${LAST_SLEEP}" --no-pager 2>/dev/null \
     | grep -q "qcom_geni_serial_suspend"; then
  systemctl restart inputplumber
fi
