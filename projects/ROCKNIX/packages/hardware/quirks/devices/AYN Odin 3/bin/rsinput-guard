#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026-present ROCKNIX/DUCKTALE
#
# Health check for the AYN Odin 3 MCU gamepad (rsinput, serdev). The MCU
# serial link can fail at probe ("Checksum mismatch") leaving the module
# loaded but NO input device registered - the pad is then dead until a
# modprobe cycle.
#
# Death signature = "AYN Odin3 Gamepad" ABSENT from /proc/bus/input/devices
# while the module is loaded. NEVER use /dev/input node presence as a
# health signal: InputPlumber HIDES the physical node while attached, so a
# missing node is the NORMAL healthy state (first guard version used it and
# modprobe-cycled a healthy pad mid-game every ~90s - live 2026-07-20).
#
# Run periodically (transient timer installed by 052-stick-calibration).
# Two consecutive dead checks -> reload the module (the udev rule re-applies
# the calibration on module add) and ALWAYS restart InputPlumber: a
# surviving virtual pad can be orphaned from the recreated physical device.
# No-op while the module is unloaded (suspend).

MISS=/run/rsinput/guard-miss

if [ ! -d /sys/module/rsinput ]; then
  rm -f "${MISS}"
  exit 0
fi

if grep -q 'N: Name="AYN Odin3 Gamepad"' /proc/bus/input/devices 2>/dev/null; then
  rm -f "${MISS}"
  exit 0
fi

m=$(( $(cat "${MISS}" 2>/dev/null || echo 0) + 1 ))
if [ ${m} -lt 2 ]; then
  echo ${m} > "${MISS}"
  exit 0
fi
rm -f "${MISS}"

logger -t rsinput-guard "gamepad unregistered (module loaded), reloading rsinput"
modprobe -r rsinput 2>/dev/null
sleep 1
modprobe rsinput
sleep 3

if ! grep -q 'N: Name="AYN Odin3 Gamepad"' /proc/bus/input/devices 2>/dev/null; then
  logger -t rsinput-guard "gamepad still absent after reload (MCU probe failed)"
  exit 1
fi

systemctl restart inputplumber
logger -t rsinput-guard "gamepad recovered (inputplumber restarted)"
