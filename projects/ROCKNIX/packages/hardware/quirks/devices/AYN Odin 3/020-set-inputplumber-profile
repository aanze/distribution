#
# Apply the saved InputPlumber gamepad-profile preference at boot via the
# shared backend. Profiles: xbox-elite (default, the back paddles work as real
# game buttons P1/P3) and ds5 (DualSense, gyro, no paddles). The backend
# handles the /run bind-mount override and the paddle-source strip; for the
# default (xbox-elite) profile it is a no-op since the base YAML already is it.

[ -x /usr/bin/gamepad-profile ] || exit 0
/usr/bin/gamepad-profile apply
