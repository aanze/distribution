#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# rocknix-screenrecord {start|stop|toggle|status} -- system-wide screen recording
# via the DPU CWB capture ring (/dev/dpu_capture0) + Iris H.264 encoder.
#
# The recorder runs in its OWN transient systemd unit (systemd-run) so it is
# independent of input.service / sway / essway -- those restart during an
# ES<->Steam handoff and would otherwise kill a recorder in their cgroup. This
# is what lets one recording span launching/leaving Steam.

. /etc/profile 2>/dev/null

REC=/usr/bin/rocknix-cwb-record
DIR=/storage/roms/screenshots/video
UNIT=rocknix-screenrecord
OUTF=/tmp/.screenrecord.out
FPS=30
# Display rotation baked into the .mp4 so it plays landscape on a PC. The panel
# is portrait-native; 90 undoes the compositor rotation. Override with
# `screenrecord.rotation` (0|90|180|270) if a clip comes out upside down.
ROT="$(get_setting screenrecord.rotation 2>/dev/null)"
[ -z "$ROT" ] && ROT=270

is_running() { systemctl is-active --quiet "${UNIT}.service" 2>/dev/null; }

# Kernel capture pause/resume knob. Used to quiesce the DPU writeback BEFORE a
# compositor switch (sway<->gamescope) while the old display is still live, so
# no writeback is left armed when the compositor tears down (an orphaned WB
# hangs the display CTL = black screen). The recorder keeps running in its own
# scope, so one clip spans the whole session: ES -> gameplay -> ES.
PAUSE_KNOB=/sys/kernel/debug/dpu_capture/pause

case "$1" in
  start)
    if [ ! -e /dev/dpu_capture0 ]; then
      /usr/bin/mako-notify "Recording unavailable" -no-ra 2>/dev/null
      echo "no /dev/dpu_capture0"; exit 1
    fi
    is_running && { echo "already recording"; exit 0; }
    systemctl reset-failed "${UNIT}.service" 2>/dev/null
    mkdir -p "$DIR"
    OUT="$DIR/$(date +'%Y-%m-%d-%H%M%S').mp4"
    echo "$OUT" > "$OUTF"
    # own unit -> survives input.service/sway restarts across the Steam handoff
    systemd-run --collect --quiet --unit="$UNIT" "$REC" "$OUT" 0 "$FPS" "$ROT" || {
      /usr/bin/mako-notify "Recording failed to start" -no-ra 2>/dev/null
      echo "systemd-run failed"; exit 1
    }
    /usr/bin/mako-notify "Recording started" -no-ra 2>/dev/null
    echo "recording -> $OUT"
    ;;
  stop)
    is_running || { rm -f "$OUTF"; exit 0; }
    systemctl stop "${UNIT}.service" 2>/dev/null   # SIGTERM -> encoder drains -> exit
    /usr/bin/mako-notify "Recording saved" -no-ra 2>/dev/null
    [ -f "$OUTF" ] && echo "saved $(cat "$OUTF")"
    rm -f "$OUTF"
    ;;
  toggle)
    if is_running; then "$0" stop; else "$0" start; fi
    ;;
  pause)
    # No-op unless a recording is active. Drains the in-flight writeback while
    # the current compositor is still live, then holds capture off.
    is_running || exit 0
    [ -w "$PAUSE_KNOB" ] && echo 1 > "$PAUSE_KNOB"
    ;;
  resume)
    is_running || exit 0
    [ -w "$PAUSE_KNOB" ] && echo 0 > "$PAUSE_KNOB"
    ;;
  status)
    is_running && echo recording || echo idle
    ;;
  *)
    echo "usage: $0 {start|stop|toggle|pause|resume|status}"; exit 1
    ;;
esac
