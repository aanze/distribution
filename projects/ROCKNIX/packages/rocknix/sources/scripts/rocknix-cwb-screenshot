#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2026-present ROCKNIX/DUCKTALE
#
# System-wide screenshot via the DPU Concurrent WriteBack capture engine
# (kernel: dpu_capture, patch 0506). Unlike grim (wlroots/sway only), this grabs
# the frame at the display-controller level, so it works under ANY compositor --
# EmulationStation/sway, RetroArch, standalone emulators, AND gamescope/Steam.
#
# Saves a timestamped PNG to /storage/roms/screenshots. The caller (input_sense)
# shows the "Screenshot Saved" toast on exit 0.

. /etc/profile 2>/dev/null

CAP=/sys/kernel/debug/dpu_capture
SAVE_DIR=/storage/roms/screenshots
RAW=/tmp/.cwb-shot.raw
# capture geometry: XRGB8888, stride padded to 256B -> 1088 px wide
W=1080; H=1920; SW=1088

# Fall back to the grim-based capture if the kernel CWB engine is unavailable.
if [ ! -e "${CAP}/arm" ]; then
  [ -x /usr/bin/rocknix-screenshot ] && exec /usr/bin/rocknix-screenshot
  echo "dpu_capture not available"
  exit 1
fi

# Arm the CWB single-shot, busy-poll until a fresh frame lands (snappier than a
# fixed sleep), copy it out, disarm. Echoes the frame count reached so the caller
# can tell a real grab (>=2) from a wedged engine (0).
arm_and_grab() {
  echo 1 > "${CAP}/arm"
  local i=0 f=0
  while [ ${i} -lt 400 ]; do
    f=$(sed -n 's/.*frames=\([0-9]*\).*/\1/p' "${CAP}/status" 2>/dev/null)
    [ "${f:-0}" -ge 2 ] && break
    i=$((i + 1))
  done
  cp "${CAP}/frame.raw" "${RAW}" 2>/dev/null
  echo 0 > "${CAP}/arm"
  printf '%s' "${f:-0}"
}

# Recover a WEDGED CWB. The single-shot writeback can get stuck (status frames=0,
# all-black frame) after a screen-record or a session teardown (gamescope kill):
# the writeback rides the live compositor CTL's flush, and a teardown leaves it
# bound to a dead CTL so no frame ever completes. Power-cycling the display output
# tears the DPU pipeline down and back up, re-binding the CWB to a live CTL.
# sway/EmulationStation only (best-effort under gamescope, where it's a no-op).
cwb_recover() {
  local sock
  sock=$(find /run -name 'sway-ipc.*.sock' 2>/dev/null | head -1)
  [ -S "${sock}" ] || return 1
  SWAYSOCK="${sock}" swaymsg 'output * power off' >/dev/null 2>&1 || return 1
  sleep 0.6
  SWAYSOCK="${sock}" swaymsg 'output * power on'  >/dev/null 2>&1
  sleep 0.9
  return 0
}

mkdir -p "${SAVE_DIR}"
OUT="${SAVE_DIR}/$(date +'%Y-%m-%d-%H%M%S').png"

# A running recording owns the CWB engine (arming the debugfs single-shot while
# the NV12 ring is live yields an empty frame.raw -- the "screenshot during a
# record silently fails" trap). Ask the recorder for a frame instead: SIGUSR1
# makes rocknix-cwb-record dump its next ring frame as tight BGRA.
LIVE=/tmp/.cwb-live-shot.bgra
if systemctl is-active --quiet rocknix-screenrecord.service 2>/dev/null; then
  rm -f "${LIVE}"
  systemctl kill --signal=USR1 rocknix-screenrecord.service 2>/dev/null
  i=0
  while [ ${i} -lt 40 ]; do    # ~2s: next ring frame + NV12->BGRA + write
    [ -s "${LIVE}" ] && break
    sleep 0.05; i=$((i + 1))
  done
  if [ -s "${LIVE}" ]; then
    convert -size ${W}x${H} -depth 8 bgra:"${LIVE}" -rotate 270 "${OUT}" 2>/dev/null
    RC=$?
    rm -f "${LIVE}"
    if [ ${RC} -eq 0 ] && [ -s "${OUT}" ]; then
      /usr/bin/capture-feedback shot-ok >/dev/null 2>&1 &
      echo "Screenshot saved (live ring): ${OUT}"
      exit 0
    fi
  fi
  /usr/bin/capture-feedback shot-fail >/dev/null 2>&1 &
  echo "live-ring screenshot failed"
  exit 1
fi

frames=$(arm_and_grab)
if [ "${frames:-0}" -lt 2 ]; then
  # Wedged engine -> recover the display pipeline and retry once.
  cwb_recover && frames=$(arm_and_grab)
fi

# frames<2 means nothing real latched (frame.raw is an 8 MB zero buffer, which
# would otherwise convert to a black PNG) -> treat as failure.
if [ "${frames:-0}" -lt 2 ] || [ ! -s "${RAW}" ]; then
  /usr/bin/capture-feedback shot-fail >/dev/null 2>&1 &
  echo "capture produced no data (frames=${frames})"
  rm -f "${RAW}"
  exit 1
fi

# raw BGRX -> PNG: crop the stride padding away, then rotate the panel-native
# portrait frame (the CWB grabs the 1080x1920 panel buffer) to the landscape
# orientation the user actually sees (270 CW = 90 CCW).
convert -size ${SW}x${H} -depth 8 bgra:"${RAW}" -crop ${W}x${H}+0+0 +repage -rotate 270 "${OUT}" 2>/dev/null
RC=$?
rm -f "${RAW}"

if [ ${RC} -eq 0 ] && [ -s "${OUT}" ]; then
  # LED-ring feedback: the caller's toast is invisible under gamescope/Steam
  /usr/bin/capture-feedback shot-ok >/dev/null 2>&1 &
  echo "Screenshot saved: ${OUT}"
  exit 0
fi
/usr/bin/capture-feedback shot-fail >/dev/null 2>&1 &
echo "screenshot failed (convert rc=${RC})"
exit 1
