#
# Boot hook: deploy the vendored ROCKNIX Control Decky plugin if Decky is present
# (version-gated, idempotent). Backgrounded so it never delays boot.

[ -x /usr/bin/rocknix-control-deploy ] && /usr/bin/rocknix-control-deploy >/dev/null 2>&1 &
exit 0
