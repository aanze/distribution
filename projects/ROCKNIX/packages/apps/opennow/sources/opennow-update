#
# Manage the on-demand OpenNOW (GeForce NOW client) AppImage install.
#
# OpenNOW publishes arm64 AppImages under tagged GitHub releases:
#   https://github.com/OpenCloudGaming/OpenNOW/releases  (we track /latest)
# The latest tag is recorded for idempotency so re-running 'update' on an
# already-current install skips the ~150 MB download.
#
# Unlike Citron/RPCS3, OpenNOW keeps its AppImage *and* its launchers together
# in the ROM folder, because EmulationStation only shows the OpenNOW main-menu
# section while that folder contains launchers (empty folder == hidden system):
#   /storage/roms/opennow/OpenNOW.AppImage           (active)
#   /storage/roms/opennow/OpenNOW.previous.AppImage  (rollback copy)
#   /storage/roms/opennow/OpenNOW.sh                 (launcher)
#   /storage/roms/opennow/OpenNOW (Mouse).sh         (touch-as-mouse launcher)
# The launcher always runs OpenNOW.AppImage, so rollback only swaps the files.
#
# Modes:  install | update | rollback | uninstall   (install == update)
#         install/update accept --force to redownload even if already current.
#
# Safety:
#   - Atomic install (download to .part, rename only after sanity checks).
#   - Integrity: minimum size + ELF magic bytes (AppImages are ELF).
#   - The previous good AppImage is kept for rollback.
#   - Lock dir prevents concurrent runs.
#   - Idempotent: skips the download if the latest tag is already installed.

source /etc/profile

MODE="${1:-update}"
FORCE=0
[ "${2:-}" = "--force" ] && FORCE=1

OPENNOW_DIR="/storage/roms/opennow"
APPIMAGE="${OPENNOW_DIR}/OpenNOW.AppImage"
PREVIOUS="${OPENNOW_DIR}/OpenNOW.previous.AppImage"
PART="${OPENNOW_DIR}/OpenNOW.AppImage.part"
LAUNCHER="${OPENNOW_DIR}/OpenNOW.sh"
LAUNCHER_MOUSE="${OPENNOW_DIR}/OpenNOW (Mouse).sh"
INSTALLED_TAG_FILE="${OPENNOW_DIR}/.installed_tag"
LOG="${OPENNOW_DIR}/opennow.log"
LOCK_DIR="/tmp/opennow-update.lock"
RELEASES_API="https://api.github.com/repos/OpenCloudGaming/OpenNOW/releases/latest"

cleanup() {
  rm -f "${PART}"
  rmdir "${LOCK_DIR}" 2>/dev/null || true
}

fail() {
  echo ""
  echo "ERROR: $*"
  echo ""
  echo "The currently installed OpenNOW has NOT been modified."
  cleanup
  sleep 15
  exit 1
}

write_launchers() {
  cat > "${LAUNCHER}" <<'EOF'
#!/bin/bash
exec /usr/bin/start_opennow.sh
EOF
  chmod +x "${LAUNCHER}"

  # Second launcher that runs opennow-touchmouse-daemon alongside OpenNOW, so
  # the touchscreen acts as a mouse (tap = left click, drag = pointer move).
  # Useful when GeForce NOW boots a "good" game into the desktop Steam UI
  # instead of Big Picture - the controller doesn't navigate that screen, but
  # tap-to-click does. The daemon is killed when OpenNOW exits.
  cat > "${LAUNCHER_MOUSE}" <<'EOF'
#!/bin/bash
/usr/bin/opennow-touchmouse-daemon &
DAEMON_PID=$!
trap 'kill ${DAEMON_PID} 2>/dev/null' EXIT
/usr/bin/start_opennow.sh
EOF
  chmod +x "${LAUNCHER_MOUSE}"
}

mkdir -p "${OPENNOW_DIR}"

### ----------------------------------------------------------------- rollback
if [ "${MODE}" = "rollback" ]; then
  echo "=== OpenNOW rollback ==="
  if [ -f "${PREVIOUS}" ]; then
    TMP="${OPENNOW_DIR}/.swap.AppImage"
    mv -f "${APPIMAGE}" "${TMP}" 2>/dev/null
    mv -f "${PREVIOUS}" "${APPIMAGE}"
    if [ -f "${TMP}" ]; then
      mv -f "${TMP}" "${PREVIOUS}"
    else
      rm -f "${PREVIOUS}"
    fi
    # The restored AppImage is from an unknown tag; clear the marker so the next
    # 'Update OpenNOW' re-evaluates against the latest release.
    rm -f "${INSTALLED_TAG_FILE}"
    write_launchers
    echo "Swapped to the previous OpenNOW AppImage."
  elif [ -x "${APPIMAGE}" ]; then
    echo "No previous version kept; the current OpenNOW install is unchanged."
    echo "Run 'Update OpenNOW' to fetch the latest build."
  else
    echo "Nothing to roll back - OpenNOW is not installed."
  fi
  sleep 8
  exit 0
fi

### ---------------------------------------------------------------- uninstall
if [ "${MODE}" = "uninstall" ]; then
  echo "=== Uninstall OpenNOW ==="
  rm -f "${APPIMAGE}" "${PREVIOUS}" "${PART}" "${INSTALLED_TAG_FILE}" \
        "${LAUNCHER}" "${LAUNCHER_MOUSE}" "${LOG}"
  echo "Removed the OpenNOW AppImage(s) and launchers."
  echo "Your NVIDIA login/config under /storage/.config/opennow-stable was kept."
  echo "The OpenNOW section disappears from the main menu after restarting"
  echo "EmulationStation."
  sleep 8
  exit 0
fi

### ------------------------------------------------------------ install/update
if ! mkdir "${LOCK_DIR}" 2>/dev/null; then
  echo "An OpenNOW install/update is already running. Retry in a few seconds."
  sleep 5
  exit 1
fi
trap cleanup EXIT

echo "=== OpenNOW installer/updater ==="
echo "Source: ${RELEASES_API}"
echo ""

if [ -f "${INSTALLED_TAG_FILE}" ]; then
  echo "Currently installed: $(cat "${INSTALLED_TAG_FILE}")"
else
  echo "No managed install yet."
fi
echo ""

echo "Querying the latest arm64 release..."
META="$(curl -fsSL "${RELEASES_API}")" || fail "could not reach the GitHub API. Check your network."

LATEST_TAG="$(printf '%s' "${META}" \
  | grep -oE '"tag_name": *"[^"]+"' \
  | head -n1 \
  | sed -E 's/.*"([^"]+)".*/\1/')"
ASSET_URL="$(printf '%s' "${META}" \
  | grep -oE '"browser_download_url": *"[^"]*"' \
  | sed -E 's/.*"(https[^"]+)".*/\1/' \
  | grep -iE 'arm64|aarch64' \
  | grep -iE '\.AppImage$' \
  | head -n1)"
[ -n "${ASSET_URL}" ] || fail "no arm64 .AppImage found in the latest OpenNOW release. Check https://github.com/OpenCloudGaming/OpenNOW/releases manually."

echo "Latest available: ${LATEST_TAG:-unknown} (${ASSET_URL##*/})"
echo ""

# No-op short-circuit: if the AppImage is already at LATEST_TAG, skip the
# ~150 MB download. We still rewrite the launchers (idempotent) so the menu
# section stays consistent even if a launcher was deleted by the user.
if [ "${FORCE}" != "1" ] && [ -x "${APPIMAGE}" ] && [ -n "${LATEST_TAG}" ] \
   && [ -f "${INSTALLED_TAG_FILE}" ] \
   && [ "$(cat "${INSTALLED_TAG_FILE}")" = "${LATEST_TAG}" ]; then
  echo "OpenNOW is already up to date (${LATEST_TAG}). Nothing to do."
  echo "Re-run from SSH with --force to redownload."
  write_launchers
  /usr/bin/rocknix-browser --ensure >/dev/null 2>&1 || true
  sleep 5
  exit 0
fi

echo "Downloading: ${ASSET_URL}"
rm -f "${PART}"
wget -c -t 5 -O "${PART}" "${ASSET_URL}" || fail "download failed."

# Integrity: non-trivial size + ELF magic bytes. The arm64 build is ~150 MB, so
# anything under 40 MB is a truncated download or an error page.
SIZE="$(stat -c%s "${PART}" 2>/dev/null || echo 0)"
if [ "${SIZE}" -lt 40000000 ]; then
  fail "downloaded file is suspiciously small (${SIZE} bytes)."
fi
MAGIC="$(head -c4 "${PART}" | od -An -tx1 | tr -d ' \n')"
if [ "${MAGIC}" != "7f454c46" ]; then
  fail "downloaded file is not an ELF binary (magic=${MAGIC})."
fi

chmod +x "${PART}"

# Rotate: current -> previous, .part -> current. The AppImage is a single
# self-contained file so the rename is atomic; no partial states are possible.
if [ -f "${APPIMAGE}" ]; then
  mv -f "${APPIMAGE}" "${PREVIOUS}"
fi
mv -f "${PART}" "${APPIMAGE}"
[ -n "${LATEST_TAG}" ] && printf '%s\n' "${LATEST_TAG}" > "${INSTALLED_TAG_FILE}"

# Pre-fetch the on-device login browser now so the first NVIDIA OAuth login
# (which has a short timeout) doesn't have to download it on the fly.
echo "Preparing the on-device login browser..."
/usr/bin/rocknix-browser --ensure || \
  echo "WARNING: browser pre-fetch failed; it will retry at first login."

write_launchers

echo ""
echo "OpenNOW ${LATEST_TAG:-installed} successfully."
if [ -f "${PREVIOUS}" ]; then
  echo "Previous version kept at: ${PREVIOUS} (use 'Rollback OpenNOW' if needed)."
fi
echo "Restart EmulationStation to see the OpenNOW section in the main menu."
echo "Two launchers are available: 'OpenNOW' (normal) and 'OpenNOW (Mouse)'"
echo "(turns the touchscreen into a mouse - use it for games whose Steam shell"
echo " doesn't accept the controller)."
echo "On first launch, the NVIDIA login opens in an on-device browser - no SSH needed."
sleep 12
