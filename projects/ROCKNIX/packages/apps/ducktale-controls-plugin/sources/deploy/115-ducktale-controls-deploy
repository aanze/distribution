#
# Boot hook: deploy the vendored DUCKTALE-CONTROLS Decky plugin if Decky is
# present (version-gated, idempotent). Backgrounded so it never delays boot.

[ -x /usr/bin/ducktale-controls-deploy ] && /usr/bin/ducktale-controls-deploy >/dev/null 2>&1 &
exit 0
