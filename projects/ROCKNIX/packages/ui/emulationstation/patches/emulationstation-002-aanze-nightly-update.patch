diff --git a/es-app/src/guis/GuiMenu.cpp b/es-app/src/guis/GuiMenu.cpp
index 96bea5a3..dfc1a0ab 100644
--- a/es-app/src/guis/GuiMenu.cpp
+++ b/es-app/src/guis/GuiMenu.cpp
@@ -1308,6 +1308,22 @@ void GuiMenu::openUpdatesSettings()
 				mWindow->pushGui(new GuiUpdate(mWindow));
 			}
 		});
+
+		// Start update from Anze's personal nightly releases (github.com/aanze/distribution).
+		// Reuses the stock GuiUpdate/ApiSystem flow but points it at the "aanze-update"
+		// backend instead of "rocknix-update"; staging + apply-on-reboot are identical.
+		updateGui->addEntry(_("UPDATE TO AANZE NIGHTLY"), true, [this]
+		{
+			if (GuiUpdate::state == GuiUpdateState::State::UPDATER_RUNNING)
+				mWindow->pushGui(new GuiMsgBox(mWindow, _("UPDATER IS ALREADY RUNNING")));
+			else
+			{
+				if (!checkNetwork())
+					return;
+
+				mWindow->pushGui(new GuiUpdate(mWindow, "aanze-update"));
+			}
+		});
 	}
 
 	mWindow->pushGui(updateGui);
