 }
 
+void VolumeInfoComponent::applyScreenTheme(const std::shared_ptr<ThemeData>& theme)
+{
+	mThemedColors = false;
+	if (theme == nullptr)
+		return;
+
+	const ThemeData::ThemeElement* elem = theme->getElement("screen", "volumeInfo", "volumeInfo");
+	if (elem == nullptr)
+		return;
+
+	if (elem->has("color"))
+	{
+		mBarColor = elem->get<unsigned int>("color");
+		mTrackColor = mBarColor;
+		mThemedColors = true;
+	}
+	if (elem->has("backColor"))
+	{
+		mTrackColor = elem->get<unsigned int>("backColor");
+		mThemedColors = true;
+	}
+}
+
 void VolumeInfoComponent::render(const Transform4x4f& parentTrans)
 {
 	if (!mVisible || mDisplayTime < 0)
@@ -136,8 +162,11 @@
 	float w = getSize().x() - 2 * PADDING_PX - 2 * PADDING_BAR;
 	float h = getSize().y() - mLabel->getSize().y() - PADDING_PX - PADDING_PX;
 	
-	Renderer::drawRect(x, y, w, h, (theme->Text.color & 0xFFFFFF00) | (opacity / 2));
+	unsigned int track = mThemedColors ? mTrackColor : theme->Text.color;
+	unsigned int bar = mThemedColors ? mBarColor : theme->TextSmall.color;
+
+	Renderer::drawRect(x, y, w, h, (track & 0xFFFFFF00) | (opacity / 2));
 
 	float px = (h*mVolume) / 100;
-	Renderer::drawRect(x, y + h - px, w, px, (theme->TextSmall.color & 0xFFFFFF00) | opacity);
+	Renderer::drawRect(x, y + h - px, w, px, (bar & 0xFFFFFF00) | opacity);
 }
