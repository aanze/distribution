+void SystemScreenSaver::updateClockScreenSaver(int deltaTime)
+{
+	const float screenW = (float)Renderer::getScreenWidth();
+	const float screenH = (float)Renderer::getScreenHeight();
+
+	// Conservative block size so the drift never pushes the text off-screen;
+	// the exact text size is measured again at render time.
+	const float blockW = screenW * 0.45f;
+	const float blockH = screenH * 0.24f;
+	const float minX = screenW * 0.04f;
+	const float minY = screenH * 0.04f;
+	const float maxX = screenW - blockW - minX;
+	const float maxY = screenH - blockH - minY;
+
+	if (!mClockInitialized)
+	{
+		mClockInitialized = true;
+		mClockPosX = (screenW - blockW) * 0.5f;
+		mClockPosY = (screenH - blockH) * 0.5f;
+		// Slow diagonal drift (~20 px/s), OLED-friendly.
+		mClockVelX = screenH * 0.00002f;
+		mClockVelY = screenH * 0.000017f;
+	}
+
+	mClockPosX += mClockVelX * (float)deltaTime;
+	mClockPosY += mClockVelY * (float)deltaTime;
+
+	// Bounce off the margins (DVD-logo style).
+	if (mClockPosX <= minX)      { mClockPosX = minX; mClockVelX = -mClockVelX; }
+	else if (mClockPosX >= maxX) { mClockPosX = maxX; mClockVelX = -mClockVelX; }
+
+	if (mClockPosY <= minY)      { mClockPosY = minY; mClockVelY = -mClockVelY; }
+	else if (mClockPosY >= maxY) { mClockPosY = maxY; mClockVelY = -mClockVelY; }
+}
+
+void SystemScreenSaver::renderClockScreenSaver()
+{
+	const float screenW = (float)Renderer::getScreenWidth();
+	const float screenH = (float)Renderer::getScreenHeight();
+
+	// Opaque black background — minimal lit pixels for the OLED.
+	Renderer::setMatrix(Transform4x4f::Identity());
+	Renderer::drawRect(0.0f, 0.0f, screenW, screenH, 0x000000FF, 0x000000FF);
+
+	if (!mClockInitialized)
+		updateClockScreenSaver(0);
+
+	// Reuse the shared screensaver date/time format settings.
+	std::string timeFormat = Settings::getInstance()->getString("ScreenSaverTimeFormat");
+	std::string dateFormat = Settings::getInstance()->getString("ScreenSaverDateFormat");
+	if (timeFormat.empty()) timeFormat = "%H:%M";
+	if (dateFormat.empty()) dateFormat = "%Y-%m-%d";
+
+	time_t now = time(nullptr);
+	struct tm* lt = localtime(&now);
+	char timeBuf[64] = { 0 };
+	char dateBuf[64] = { 0 };
+	if (lt != nullptr)
+	{
+		strftime(timeBuf, sizeof(timeBuf), timeFormat.c_str(), lt);
+		strftime(dateBuf, sizeof(dateBuf), dateFormat.c_str(), lt);
+	}
+
+	auto timeFont = Font::get((int)(screenH * 0.13f));
+	auto dateFont = Font::get((int)(screenH * 0.05f));
+	if (timeFont == nullptr || dateFont == nullptr)
+		return;
+
+	Vector2f timeSize = timeFont->sizeText(timeBuf);
+	Vector2f dateSize = dateFont->sizeText(dateBuf);
+
+	const float blockCenterX = mClockPosX + (screenW * 0.45f) * 0.5f;
+	const float gap = screenH * 0.015f;
+
+	const float timeX = blockCenterX - timeSize.x() * 0.5f;
+	const float timeY = mClockPosY;
+	const float dateX = blockCenterX - dateSize.x() * 0.5f;
+	const float dateY = timeY + timeSize.y() + gap;
+
+	// Dimmed grey — clearly readable but easy on the OLED.
+	const unsigned int timeColor = 0xC0C0C0FF;
+	const unsigned int dateColor = 0x909090FF;
+
+	Renderer::setMatrix(Transform4x4f::Identity());
+
+	TextCache* timeCache = timeFont->buildTextCache(timeBuf, timeX, timeY, timeColor);
+	if (timeCache != nullptr)
+	{
+		timeFont->renderTextCache(timeCache);
+		delete timeCache;
+	}
+
+	TextCache* dateCache = dateFont->buildTextCache(dateBuf, dateX, dateY, dateColor);
+	if (dateCache != nullptr)
+	{
+		dateFont->renderTextCache(dateCache);
+		delete dateCache;
+	}
+}
