  ## RPCS3 Update / Rollback Tools entries (the ps3 system itself ships
  ## upstream). Drop-in ES wiring (see the pkg-emus.d loop at the top of
  ## makeinstall_target): file-add only, no shared-file edits. Same device
  ## gate as upstream's ps3 block.
  case ${DEVICE} in
    SM8250|SM8550|SM8650|SM8750)
      install_script "Update RPCS3.sh"
      install_script "Rollback RPCS3.sh"
      ;;
  esac
