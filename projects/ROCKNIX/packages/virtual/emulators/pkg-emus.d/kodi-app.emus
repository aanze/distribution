# kodi-app (Kodi 21 media center + PM4K Plex client, bundled; opt-in ES
# section created by Tools > "Install Kodi"). Drop-in snippet (see the
# pkg-emus.d loop in package.mk): file-add only, no shared-file edits.
# ES wiring lives in the matching kodi-app.wiring file.
case "${DEVICE}" in
  SM8250|SM8550|SM8650|SM8750)
    PKG_EMUS+=" kodi-app"
    ;;
esac
