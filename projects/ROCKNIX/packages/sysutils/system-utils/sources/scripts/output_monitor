#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2025 ROCKNIX (https://github.com/ROCKNIX)
#
# Monitors external display outputs (DP, HDMI) via sway IPC and powers
# internal panels (DSI, eDP) off/on accordingly.
#
# The sway IPC subscription is used rather than udev because the actions
# (wlr-randr, swaymsg) require sway to be running and to have already
# processed the new output. Subscribing to sway output events is
# inherently synchronized with sway's internal state, avoiding the need
# for retry logic after a kernel hotplug uevent.

. /etc/profile

# Exit if this device has no external display connectors at all
ls /sys/class/drm/card*-DP-* /sys/class/drm/card*-HDMI-A-* 2>/dev/null | grep -q . || exit 0

_LAST_STATE="init"

_get_active_externals() {
    wlr-randr 2>/dev/null | awk '
        /^(DP|HDMI|DisplayPort)-/ { name=$1; in_ext=1; next }
        /^[A-Za-z]/ { in_ext=0 }
        in_ext && /Enabled: yes/ { print name }
    '
}

_get_all_internals() {
    wlr-randr 2>/dev/null | awk '/^(DSI|eDP|LVDS)-/ { print $1 }'
}

_wp_audio_card() {
    wpctl status 2>/dev/null | awk -F'[.[:space:]]+' '
        /\[alsa\]/ { for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+$/) { print $i; exit } }'
}

_wp_profile_index() {
    pw-cli enum-params "$1" EnumProfile 2>/dev/null | awk -v want="$2" '
        /Param:Profile:index/ { getline; idx = $2 }
        /Param:Profile:name/  { getline; gsub(/"/, "", $2); if ($2 == want) { print idx; exit } }'
}

_switch_audio() {
    local card target i
    card=$(_wp_audio_card); [ -n "$card" ] || return 0
    if [ "$1" = "external" ]; then
        target=$(_wp_profile_index "$card" "HDMI")
        if [ -z "$target" ]; then
            systemctl restart wireplumber 2>/dev/null || true
            for i in $(seq 1 20); do
                sleep 0.5
                card=$(_wp_audio_card)
                [ -n "$card" ] && target=$(_wp_profile_index "$card" "HDMI")
                [ -n "$target" ] && break
            done
        fi
    else
        target=$(_wp_profile_index "$card" "HiFi")
    fi
    [ -n "$card" ] && [ -n "$target" ] && wpctl set-profile "$card" "$target" 2>/dev/null || true
}

# Usable payload bits/s on a DP connector. A dock that carries USB 3 alongside
# video only gets two of the four lanes, which is far less headroom than the
# sink's preferred mode assumes: an Odin 3 on a 3440x1440 ultrawide negotiates
# 2 lanes of HBR2 (8.64 Gbit/s usable) while the preferred 3440x1440@100 mode
# needs about 16. Driving it anyway drops the link entirely or scans out noise.
# msm exposes the negotiated link in debugfs; fall back to that same 2-lane
# HBR2 elsewhere, which is the pessimistic case and therefore the safe guess.
_link_budget_bps() {
    local dbg rate lanes
    dbg=$(cat /sys/kernel/debug/dri/*/"$1"/dp_debug 2>/dev/null)
    rate=$(printf '%s\n' "$dbg" | awk '/rate =/ {print $3; exit}')
    lanes=$(printf '%s\n' "$dbg" | awk '/num_lanes =/ {print $3; exit}')
    case "${rate}${lanes}" in ''|*[!0-9]*) rate=540000; lanes=2 ;; esac
    # rate is the per-lane symbol clock in kHz; 8b/10b puts 8 payload bits in
    # each symbol, so the coding overhead is already accounted for here.
    echo $(( rate * 1000 * 8 * lanes ))
}

# Bits/s a mode needs. Blanking is not in the mode list, so scale the active
# pixel rate by the ~1.2 that real timings carry, and bill it at the link's
# bits per pixel (msm reports 30 on this panel, not the 24 one would assume).
_mode_cost_bps() {
    local w="$1" h="$2" hz="$3" bpp="$4"
    echo $(( w * h * hz * 12 / 10 * bpp ))
}

# Pick the largest mode that keeps the sink's own aspect ratio and still fits
# the link. Matching the aspect is what stops the display stretching the
# picture, and is why this cannot simply pin 1920x1080: on a 21:9 sink that is
# a 16:9 signal, which its scaler then pulls across the full width.
_set_best_mode() {
    local out="$1" budget bpp modes pref_w pref_h pref_aspect
    budget=$(_link_budget_bps "$out")
    bpp=$(cat /sys/kernel/debug/dri/*/"$out"/dp_debug 2>/dev/null | awk '/bpp =/ {print $3; exit}')
    case "$bpp" in ''|*[!0-9]*) bpp=30 ;; esac

    modes=$(wlr-randr 2>/dev/null | awk -v o="$out" '
        $1 == o { inout = 1; next }
        /^[A-Za-z]/ { inout = 0 }
        inout && /px,/ {
            # "  2560x1080 px, 60.000000 Hz (preferred)" -> "2560 1080 60 pref"
            gsub(/x/, " ", $1)
            printf "%s %d %s\n", $1, $3, ($0 ~ /preferred/ ? "pref" : "-")
        }')
    [ -n "$modes" ] || return 0

    read -r pref_w pref_h _ <<EOF
$(printf '%s\n' "$modes" | awk '$4 == "pref" { print; exit }')
EOF
    [ -n "$pref_h" ] && [ "$pref_h" -gt 0 ] 2>/dev/null || return 0
    pref_aspect=$(( pref_w * 1000 / pref_h ))

    local best_w= best_h= best_hz= best_px=0 w h hz aspect cost
    while read -r w h hz _; do
        [ -n "$hz" ] && [ "$hz" -gt 0 ] 2>/dev/null || continue
        aspect=$(( w * 1000 / h ))
        # 2% tolerance: 2560x1080 is not exactly 3440x1440's ratio, but it is
        # the mode a 21:9 sink expects and displays without stretching.
        [ $(( (aspect - pref_aspect) * 100 / pref_aspect )) -le 2 ] &&
        [ $(( (pref_aspect - aspect) * 100 / pref_aspect )) -le 2 ] || continue
        cost=$(_mode_cost_bps "$w" "$h" "$hz" "$bpp")
        [ "$cost" -le "$budget" ] || continue
        [ $(( w * h )) -gt "$best_px" ] || { [ $(( w * h )) -eq "$best_px" ] && [ "$hz" -gt "${best_hz:-0}" ]; } || continue
        best_w="$w"; best_h="$h"; best_hz="$hz"; best_px=$(( w * h ))
    done <<EOF
$(printf '%s\n' "$modes")
EOF

    # Always name the refresh. "--mode WxH" picks the highest one the sink
    # advertises, which on this ultrawide is 2560x1080@100 - over the link
    # budget, and back to a noisy scanout. No refresh-less fallback for that
    # reason: leaving the mode alone is safer than setting an unknown one.
    [ -n "$best_w" ] &&
        wlr-randr --output "$out" --mode "${best_w}x${best_h}@${best_hz}Hz" 2>/dev/null || true
}

# EmulationStation resolves its render resolution once, at startup, and never
# renegotiates it when the output it sits on changes size. A session that came
# up on the internal panel keeps a 1920x1080 buffer and shows as a small
# letterboxed window on a 3440x1440 dock; one that came up docked keeps the
# ultrawide buffer, which the compositor then squashes back into the panel (the
# "compressed" picture after leaving Steam while docked). Restarting the unit is
# the only way to make it adopt the geometry it now sits on. essway.service runs
# emulationstation alone -- sway.service, and therefore this monitor, survive it.
#
# Hide the old window first: until the new session paints, its stale buffer
# would be scaled across the new geometry, which is exactly the stretched frame
# we are getting rid of.
_respawn_es() {
    swaymsg "[app_id=\"emulationstation\"] fullscreen disable" 2>/dev/null || true
    swaymsg "[app_id=\"emulationstation\"] move scratchpad" 2>/dev/null || true
    systemctl restart essway 2>/dev/null || true
}

_apply() {
    local state="internal"
    [ -n "$(_get_active_externals)" ] && state="external"
    [ "$_LAST_STATE" = "$state" ] && return
    local prev="$_LAST_STATE"
    _LAST_STATE="$state"

    if [ "$state" = "external" ]; then
        local ext_out
        ext_out=$(_get_active_externals | head -1)
        while IFS= read -r out; do
            wlr-randr --output "$out" --off 2>/dev/null
        done < <(_get_all_internals)
        if [ -n "$ext_out" ]; then
            _set_best_mode "$ext_out"
            swaymsg "[app_id=\"emulationstation\"] move output ${ext_out}" 2>/dev/null || true
        fi
        # Picture before sound: _switch_audio can block for up to 10s waiting
        # for the HDMI profile to appear, and every second of that is a second
        # of stretched image on screen.
        _respawn_es
        # Stop USB gadget: its data lanes conflict with DP Alt Mode on RK3576
        systemctl is-active --quiet usbgadget && systemctl stop usbgadget
        _switch_audio external
    else
        # Only on an actual disconnect: on a first-boot internal start nothing
        # has changed yet, so the freshly started session is left alone.
        # This is also the sole path that lights the panel back up when the
        # external goes away -- without it a disconnect leaves no output
        # enabled at all and the device looks dead.
        if [ "$prev" != "init" ]; then
            while IFS= read -r out; do
                wlr-randr --output "$out" --preferred --on 2>/dev/null
            done < <(_get_all_internals)
            _respawn_es
            _switch_audio internal
        fi
    fi
}

# Allow sway to finish initialising outputs before first check
sleep 3

while true; do
    _apply
    # Block until sway reports an output event (or 10s timeout).
    # The timeout acts as a periodic retry to catch events missed when sway
    # fires before finishing output configuration (e.g. boot-time hotplug).
    # grep -q exits on first '"change"' match, terminating swaymsg cleanly.
    timeout 10 swaymsg -t subscribe '["output"]' 2>/dev/null | grep -q '"change"' || true
    sleep 0.3
done
