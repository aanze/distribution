#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2025-present ROCKNIX (https://github.com/ROCKNIX)
#
# gamepad-profile - manage the InputPlumber controller-emulation profile.
#
# Since upstream PRs #2940/#2991/#2992/#2997 the STOCK SM8750 composite is
# already the full DualSense Edge chain: gpio-keys-paddles source + ayn_mcu
# mapping the paddles to Left/RightPaddle2 + ds5-edge target (real Edge
# back-lever buttons, kernel-decoded as BTN_TRIGGER_HAPPY3/4). So:
#
#   ds5         - DualSense Edge with real back paddles = the UNMODIFIED
#                 stock config. No override at all.
#   xbox-elite  (user-facing default) - emulate an Xbox One Elite pad via a
#                 /run bind-mount override of the composite: retarget to
#                 xbox-elite and swap ONLY the paddle-source's capability map
#                 to ayn_mcu_elite (Paddle1), so the paddles come out as
#                 BTN_TRIGGER_HAPPY7 (left) / HAPPY5 (right) - the codes the
#                 fork's es_input, gamecontrollerdb and input_sense capture
#                 combos are baked against.
#
# The capture combo works in both profiles (input_sense reads HAPPY7/5 on
# the elite pad, HAPPY3/4 on the edge pad, raw BTN_Z/BTN_C as fallback).
# No gyro in either profile: the Odin 3 IMU is SLPI-owned, unreachable from
# Linux.
#
# Usage: gamepad-profile {get|label|set <profile>|toggle|apply}

source /etc/profile

SETTING="inputplumber.profile"
OVERRIDE_YAML="/run/inputplumber-profile.yaml"
ELITE_MAP="/usr/share/inputplumber/capability_maps/ayn_mcu_elite.yaml"

find_device_yaml() {
    local model
    model=$(tr -d '\0' < /sys/firmware/devicetree/base/model 2>/dev/null || \
            cat /sys/class/dmi/id/product_name 2>/dev/null)
    [ -n "${model}" ] && \
        grep -rl "value: ${model}" /usr/share/inputplumber/devices/ 2>/dev/null | head -1
}

# Map legacy / empty settings onto the two supported profiles. An empty
# setting keeps the fork's historical user-facing default: xbox-elite.
normalize() {
    case "${1}" in
        ds5|ds5-edge|dualsense)        echo "ds5" ;;
        xbox-elite|xbox-series|"")     echo "xbox-elite" ;;
        *)                             echo "${1}" ;;
    esac
}

get_profile() { normalize "$(get_setting "${SETTING}")"; }

human_label() {
    case "$(get_profile)" in
        xbox-elite) echo "Xbox Elite (paddles)" ;;
        ds5)        echo "DualSense Edge (paddles)" ;;
        *)          echo "$(get_profile)" ;;
    esac
}

apply_profile() {
    local target dev had_override="no"
    target="$(normalize "${1}")"
    dev="$(find_device_yaml)"
    [ -z "${dev}" ] && return 1

    # Drop any existing override so we transform the real base file.
    if grep -qF " ${dev} " /proc/mounts; then
        had_override="yes"
        umount "${dev}" 2>/dev/null
    fi

    if [ "${target}" = "ds5" ]; then
        # DualSense Edge = the stock config. Nothing to override; only
        # restart if we actually removed one (avoids a needless controller
        # reset at boot).
        rm -f "${OVERRIDE_YAML}"
        [ "${had_override}" = "no" ] && return 0
    else
        # xbox-elite: retarget the composite and swap the paddle source's
        # capability map to the Paddle1 variant (-> HAPPY7/5 on the emulated
        # Elite pad). The paddle source is identified by its device name.
        # Fallback: if the elite map is absent from this build, only the
        # retarget applies - the paddles then surface as Paddle2 (HAPPY8/6),
        # a degraded but functional layout.
        awk -v elitemap="$([ -f "${ELITE_MAP}" ] && echo yes || echo no)" '
            /name: gpio-keys-paddles/ { inpad=1 }
            inpad && /capability_map_id:/ {
                if (elitemap == "yes") {
                    print "    capability_map_id: ayn_mcu_elite"
                } else {
                    print
                }
                inpad=0; next
            }
            /^target_devices:/ {
                print "target_devices:"
                print "  - xbox-elite"
                print "  - keyboard"
                t=1; next
            }
            t && /^[[:space:]]*-[[:space:]]/ { next }
            { t=0; print }
        ' "${dev}" > "${OVERRIDE_YAML}"
        mount --bind "${OVERRIDE_YAML}" "${dev}"
    fi

    # Restart InputPlumber so the new target/sources take effect, then nudge
    # input_sense to re-scan (the emulated pad's paddle codes change).
    systemctl restart inputplumber
    systemctl try-restart input.service 2>/dev/null
    return 0
}

case "${1}" in
    get)    get_profile ;;
    label)  human_label ;;
    apply)  apply_profile "$(get_profile)" ;;
    set)
        new="$(normalize "${2}")"
        set_setting "${SETTING}" "${new}"
        apply_profile "${new}"
        echo "${new}"
        ;;
    toggle)
        if [ "$(get_profile)" = "xbox-elite" ]; then new="ds5"; else new="xbox-elite"; fi
        set_setting "${SETTING}" "${new}"
        apply_profile "${new}"
        echo "${new}"
        ;;
    *)
        echo "usage: gamepad-profile {get|label|set <xbox-elite|ds5>|toggle|apply}" >&2
        exit 1
        ;;
esac
