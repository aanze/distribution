#
# ES "screensaver-start" event hook ($1 = ScreenSaverBehavior).
# Pair the OLED anti-image-retention overlay with the "black" screensaver type:
# ES draws/holds black (and sleeps), our input-transparent overlay paints the
# sweeping noise band on top. Any button press reaches ES (overlay is
# input-transparent) -> ES cancels the screensaver -> fires screensaver-stop
# -> the overlay is killed.

# ES passes the ScreenSaverBehavior as an arg, but its position differs by
# convention: scripts in a scripts/<event>/ subdir (our case) are called as
# `<script> <behavior>` ($1=black); top-level scripts get `<script> <event>
# <behavior>`. Match "black" anywhere in the args to cover both.
case " $* " in
  *" black "*) : ;;
  *) exit 0 ;;
esac
pidof oledsaver >/dev/null 2>&1 && exit 0

# Wayland session env (inherited from ES, with safe fallbacks for SM8750).
: "${XDG_RUNTIME_DIR:=/var/run/0-runtime-dir}"
: "${WAYLAND_DISPLAY:=wayland-1}"
export XDG_RUNTIME_DIR WAYLAND_DISPLAY

/usr/bin/oledsaver >/dev/null 2>&1 &
exit 0
